diff -U3 -r a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c	2026-11-24 01:33:11.271638165 +0300
+++ b/bsd/dev/sweet_sample.c	2026-11-24 01:33:11.278684118 +0300
@@ -96,6 +96,48 @@
 /* TULIP 0274: progress markers read by the eMMC heartbeat (TULIP HB) */
 volatile int sweet_sample_stage;
 volatile uint64_t sweet_sample_wakes;
+/*
+ * TULIP 0323: what the sleep actually cost.
+ *
+ * The HB line showed 8 wakes in 1006 s, i.e. roughly 125 s per wakeup for a
+ * loop that asks for 30 * hz - a factor of four. Either hz is not 100, or the
+ * deadline is programmed correctly and the core wakes up late; the two have
+ * very different fixes, so record both numbers here and let HB13 print them:
+ *  [0] microseconds slept in the last tsleep
+ *  [1] ticks that tsleep was asked to sleep (the 30 * hz argument)
+ *  [2] hz as the kernel sees it
+ *  [3] slowest sleep seen so far, microseconds
+ *  [4] how many tsleep calls have completed
+ *  [5] what the last sleep asked for, in ticks (the "expected" side of [0])
+ */
+volatile uint64_t tulip_sleep_us, tulip_sleep_ticks, tulip_sleep_hz;
+volatile uint64_t tulip_sleep_worst_us, tulip_sleep_calls, tulip_sleep_ask_ticks;
+
+/*
+ * TULIP 0323: tsleep() with the real elapsed time recorded.
+ *
+ * tsleep() only tells us it returned; it does not say how long the wait was.
+ * mach_absolute_time() around it does, and comparing that against the tick
+ * count we asked for says whether the sleep queue or the timer is at fault.
+ */
+static void
+tulip_sleep_measured(int *chan, int ticks)
+{
+	uint64_t t0 = mach_absolute_time(), t1;
+	uint64_t us = 0;
+
+	tulip_sleep_ask_ticks = (uint64_t)ticks;
+	tulip_sleep_hz = (uint64_t)hz;
+	(void)tsleep(chan, PZERO, "sweetsmp", ticks);
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &us);
+	tulip_sleep_us = us / 1000ULL;
+	tulip_sleep_ticks = (uint64_t)ticks;
+	if (tulip_sleep_us > tulip_sleep_worst_us) {
+		tulip_sleep_worst_us = tulip_sleep_us;
+	}
+	tulip_sleep_calls++;
+}
 
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
@@ -117,7 +159,7 @@
 		sweet_console_muted = 1;
 	}
 	sweet_sample_stage = 1;
-	(void)tsleep(&chan, PZERO, "sweetsmp", 60 * hz);
+	tulip_sleep_measured(&chan, 60 * hz);
 	sweet_sample_stage = 2;
 	sweet_sample_wakes++;
 	/* TULIP 0251: runs for the whole boot; a perf line every 5 min; freezes the console only when a wanted process exists */
@@ -144,7 +186,7 @@
 		if (perf_shown && sweet_sample_hits == 0) {
 			/* TULIP 0256: no wanted process yet; still hold the PERF line on screen for 30 s */
 			sweet_console_muted = 1;
-			(void)tsleep(&chan, PZERO, "sweetsmp", 30 * hz);
+			tulip_sleep_measured(&chan, 30 * hz);
 			sweet_console_muted = 0;
 		}
 		perf_shown = 0;
@@ -152,13 +194,13 @@
 			printf("SMP --- sample %d\n", i);
 			sweet_sample_run(sweet_sample_hits, spids, snames);
 			sweet_console_muted = 1;
-			(void)tsleep(&chan, PZERO, "sweetsmp", 100 * hz);
+			tulip_sleep_measured(&chan, 100 * hz);
 			sweet_console_muted = 0;
 		}
 		sweet_console_muted = quiet;
 		since_perf++;
 		sweet_sample_stage = 6;
-		(void)tsleep(&chan, PZERO, "sweetsmp", 30 * hz);
+		tulip_sleep_measured(&chan, 30 * hz);
 		sweet_sample_wakes++;
 	}
 }
