diff -U3 -r n367a/bsd/dev/tulip_sdhci.c n367b/bsd/dev/tulip_sdhci.c
--- a/bsd/dev/tulip_sdhci.c	2026-11-28 19:46:00.174599922 +0300
+++ b/bsd/dev/tulip_sdhci.c	2026-11-28 19:46:00.809447857 +0300
@@ -382,7 +382,15 @@
  * read path, which runs constantly during boot.
  */
 static int tt_ready;
-static int tt_nvt_lines = 0x40000000;	/* TULIP 0366: no NVT console lines */
+/*
+ * TULIP 0367: an unsigned sentinel. 0366 seeded this with 0x40000000 so the
+ * "< 300" test never passes, but the counter is a signed int that each NVT
+ * poll increments: it walks up to INT_MAX and then wraps to a negative
+ * value, which is < 300, so the whole NVT log comes back after a wrap. Make
+ * the counter unsigned and seed it high enough that a boot cannot reach the
+ * limit.
+ */
+static unsigned int tt_nvt_lines = 0x40000000u;	/* TULIP 0367: no NVT console lines */
 
 static int
 tt_write(uint8_t addr, const uint8_t *d, int n)
@@ -7056,7 +7064,19 @@
