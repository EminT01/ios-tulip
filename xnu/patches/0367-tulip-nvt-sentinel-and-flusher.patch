-		(void)tsleep(&tulip_log_chan, PZERO, "tuliplog", hz);
+		/*
+		 * TULIP 0367: every five seconds instead of every one.
+		 *
+		 * This thread wakes once a second and pushes whatever accumulated
+		 * into the 4 MiB ring out to the SYSTEM partition. On a boot that
+		 * spends its time reading dyld_shared_cache each of those writes
+		 * competes with the reads for the same card, and logd_helper is
+		 * writing the same content through the BSD log path as well (it
+		 * burned 89.5 s of system time in one boot). A log that lands five
+		 * seconds late is still a complete log: the ring keeps every byte
+		 * and the flusher drains all of it on each wake.
+		 */
+		(void)tsleep(&tulip_log_chan, PZERO, "tuliplog", 5 * hz);
 
