diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -550,6 +550,18 @@ machine_lockdown(void)
 	}
 
 	lockdown_done = 1;
+
+	/*
+	 *	TULIP: ml_wait_max_cpus() blocks until max_cpus_initialized is MAX_CPUS_SET.
+	 *	With a single CPU nothing else sets it, so do it here.  Once SMP is live,
+	 *	SweetCPU::finishStart() publishes it after every CPU has checked in, and
+	 *	setting it here would let kperf_init_early() run before the secondaries
+	 *	exist.  machine_info.max_cpus is final either way: it is derived from the
+	 *	ADT cpu nodes in machine_conf().
+	 */
+#if !defined(VINCE) || !defined(TULIP_SMP)
+	ml_set_max_cpus(machine_info.max_cpus);
+#endif
 }
 
 
