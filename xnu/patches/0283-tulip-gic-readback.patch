--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -31,6 +31,9 @@
 vm_offset_t vince_gicd_base = 0;
 vm_offset_t vince_gicc_base = 0;
 vm_offset_t vince_gicr_base = 0;
+/* TULIP 0283 */
+volatile uint32_t tulip_gic_dbg[8];
+vm_offset_t tulip_gicr_pe_base;
 uint32_t vince_vtimer_intid = SWEET_VTIMER_INTID;
 #endif
 
@@ -229,6 +232,27 @@
 	}
 	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
+#if defined(VINCE_TULIP)
+	/*
+	 * TULIP 0283: what the GIC really kept of the writes above, for the boot
+	 * CPU (shown by the TULIP HB4 line). Non-secure writes to a Group 0
+	 * interrupt are ignored, so these read back as zero if TrustZone owns it.
+	 */
+	if (tulip_gic_dbg[7] == 0) {
+		uint64_t mpidr;
+
+		__asm__ volatile ("mrs %0, mpidr_el1" : "=r"(mpidr));
+		tulip_gic_dbg[0] = gicr_read32(GICR_IGROUPR0);
+		tulip_gic_dbg[1] = gicr_read32(GICR_ISENABLER0);
+		tulip_gic_dbg[2] = gicd_read32(GICD_CTLR);
+		tulip_gic_dbg[3] = (uint32_t)mpidr & 0xffffff;
+		tulip_gic_dbg[4] = (uint32_t)(gicr_pe_base - gicr_base);
+		tulip_gic_dbg[5] = gicr_read32(0x8);
+		tulip_gic_dbg[6] = gicr_read32(0x10200);
+		tulip_gic_dbg[7] = 1;
+		tulip_gicr_pe_base = gicr_pe_base;
+	}
+#endif /* VINCE_TULIP */
 #else
 	// Enable the forwarding of the vtimer interrupt
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
--- a/bsd/dev/tulip_sdhci.c
+++ b/bsd/dev/tulip_sdhci.c
@@ -4767,6 +4767,23 @@
 				printf("TULIP HB3: cntv ctl 0x%llx cval-cnt %lld  gicr grp 0x%x enab 0x%x pend 0x%x  "
 				    "hppir 0x%llx grpen1 %llu pmr 0x%llx daif 0x%llx sre %llu\n",
 				    ctl, (long long)(cval - cnt), grp, enab, pend, hppir, grpen, pmr, daif, srcnt);
+				{
+					extern volatile uint32_t tulip_gic_dbg[8];
+					extern vm_offset_t tulip_gicr_pe_base;
+					uint32_t pg = 0, pe = 0, pp = 0;
+					uint64_t mp;
+
+					__asm__ volatile ("mrs %0, mpidr_el1" : "=r"(mp));
+					if (tulip_gicr_pe_base != 0) {
+						pg = *(volatile uint32_t *)(tulip_gicr_pe_base + 0x10080);
+						pe = *(volatile uint32_t *)(tulip_gicr_pe_base + 0x10100);
+						pp = *(volatile uint32_t *)(tulip_gicr_pe_base + 0x10200);
+					}
+					printf("TULIP HB4: mpidr 0x%llx; at init: grp 0x%x enab 0x%x gicd_ctlr 0x%x mpidr 0x%x "
+					    "frame +0x%x typer 0x%x pend 0x%x; now (own frame): grp 0x%x enab 0x%x pend 0x%x\n",
+					    mp & 0xffffff, tulip_gic_dbg[0], tulip_gic_dbg[1], tulip_gic_dbg[2],
+					    tulip_gic_dbg[3], tulip_gic_dbg[4], tulip_gic_dbg[5], tulip_gic_dbg[6], pg, pe, pp);
+				}
 			}
 		}
 		tulip_touch_poll();
