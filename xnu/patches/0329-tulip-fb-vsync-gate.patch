-		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
+	/*
+	 * TULIP 0329: the panel only shows a frame every fFlushTicks ticks, but
+	 * backboardd draws one frame per vsync on the CPU. Notifying on every tick
+	 * made it render frames nobody ever saw and burned the single core the
+	 * whole boot runs on; notify only when this tick actually copies a frame.
+	 */
+	if ((count % fb->fFlushTicks) == 0) {
+		for (unsigned int i = 0; i < fb->fClients->getCount(); i++) {
+			IOMobileFramebufferUserClient *client =
+			    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
+			client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
+		}
 	}
