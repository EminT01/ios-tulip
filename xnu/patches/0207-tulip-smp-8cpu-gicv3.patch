 void
 pe_init_fiq()
 {
+#if defined(VINCE)
+	/*
+	 * vince (MSM8953): ARM GICv2 MMIO controller.
+	 */
+	if (!vince_gicd_base) {
+		DTEntry entry;
+		if (SecureDTFindEntry("name", "interrupt-controller", &entry) == kSuccess) {
+			uint64_t const *reg;
+			unsigned int prop_size;
+			if (SecureDTGetProperty(entry, "reg", (void const **)&reg, &prop_size) == kSuccess && prop_size >= 32) {
+				vince_gicd_base = ml_io_map(reg[0], reg[1]);
+				vince_gicc_base = ml_io_map(reg[2], reg[3]);
+			}
+			void const *timer_prop;
+			if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &prop_size) == kSuccess && prop_size == sizeof(uint32_t)) {
+				vince_vtimer_intid = *(const uint32_t *)timer_prop;
+			}
+		}
+		if (!vince_gicd_base) {
+			vince_gicd_base = ml_io_map(MSM8953_GICD_BASE, 0x1000);
+		}
+		if (!vince_gicc_base) {
+			vince_gicc_base = ml_io_map(MSM8953_GICC_BASE, 0x1000);
+		}
+		kprintf("VINCE GICv2: GICD=%p GICC=%p vtimer INTID %u\n",
+		    (void *)vince_gicd_base, (void *)vince_gicc_base, vince_vtimer_intid);
+	}
