+/*
+ * Tulip SMP: all eight Kryo 260 cores, one homogeneous cluster at a 4 KiB granule.
+ *  - logical 0-3 = Silver (Cortex-A53 class), MPIDR 0x000-0x003
+ *  - logical 4-7 = Gold  (Cortex-A73 class),  MPIDR 0x100-0x103
+ * The Gold cores support 4 KiB pages too, so nothing is parked and no core needs 16 KiB.
+ * SweetCPU brings the secondaries up with PSCI CPU_ON; each one configures its own GICv3
+ * redistributor and CPU interface.  TULIP_SMP also tells machine_lockdown() to leave
+ * ml_set_max_cpus() to SweetCPU::finishStart(), which runs once every CPU checked in.
+ */
+#define TULIP_SMP                 1
+#define TULIP_SMP_MAX_CPUS        8       /* 4 Silver + 4 Gold */
