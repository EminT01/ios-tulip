+		/*
+		 * TULIP 0305: PRESENT_STATE is a second MMIO read on every spin, and
+		 * 0274 showed this core does raise BRR in INT_STATUS 99% of the time.
+		 * Poll the fallback every 4th spin while the wait is still short; if
+		 * the block is late, drop back to every spin so a transfer that really
+		 * relies on the fallback is not delayed.
+		 */
+		if (!slow_logged && (spins & 0x3u) != 0) {
+			spins++;
+			if ((spins & 0x63u) == 0) {
+				delay(1);
+			}
+			continue;
+		}
 		ps = hc_rd(SDHCI_PRESENT_STATE);
 		if (ps & ps_bit) {
 			if (!tulip_pstate_buf_logged) {
@@ -1380,7 +1394,15 @@
 			sdhci_data_failure(what, st);
 			return ETIMEDOUT;
 		}
-		delay(1);
+		/*
+		 * TULIP 0305: a microsecond of busy-wait per spin, once per block of
+		 * a CMD18 read, is a measurable share of the 512-byte transfer time.
+		 * Every 100th spin is enough to keep the rest of the kernel alive and
+		 * leaves the poll rate above a million reads a second.
+		 */
+		if ((spins & 0x63u) == 0) {
+			delay(1);
+		}
 	}
 }
 
