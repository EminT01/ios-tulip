 		}
@@ -455,8 +524,9 @@
 static void
 tulip_touch_nvt_thread(void *arg, wait_result_t w)
 {
-	uint8_t b[8];
-	int muted, a, rc, found = 0;
+	uint8_t b[72];
+	int muted, a, rc, found = 0, n, got = 0;
+	size_t i;
 
 	(void)arg; (void)w;
 	tt_spin = 1;
@@ -475,7 +545,7 @@
 	tulip_udelay(300000);
 	tt_sda(1); tt_scl(1);
 	printf("TULIP NVT: setup, idle SDA %d SCL %d irq %d\n", tt_get(2), tt_get(3), tt_get(67));
-	for (a = 0x08; a < 0x78; a++) {
+	for (a = 0x01; a < 0x78; a++) {
 		tt_start();
 		rc = tt_wbyte((uint8_t)(a << 1));
 		tt_stop();
@@ -484,13 +554,42 @@
 			found++;
 		}
 	}
-	/* chip trim id lives at 0x1f64e on the NT36xxx family */
-	rc = tt_nvt_read(0x1f64e, b, 6);
-	printf("TULIP NVT: chip id rc %d  %02x %02x %02x %02x %02x %02x\n", rc,
-	    b[0], b[1], b[2], b[3], b[4], b[5]);
-	rc = tt_nvt_read(0x11e00, b, 8);
-	printf("TULIP NVT: page 0x11e00 rc %d  %02x %02x %02x %02x %02x %02x %02x %02x\n", rc,
-	    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+	/* stock probe: boot reset, then idle + 0x35 + read the trim id at 0x1f64e */
+	tt_nvt_cmd(0x69);
+	tulip_udelay(35000);
+	for (n = 0; n < 5; n++) {
+		tt_nvt_cmd(0xA5);
+		tulip_udelay(15000);
+		tt_nvt_cmd(0x35);
+		tulip_udelay(10000);
+		rc = tt_nvt_read(0x1f64e, b, 6);
+		printf("TULIP NVT: chip id try %d rc %d  %02x %02x %02x %02x %02x %02x\n", n, rc,
+		    b[0], b[1], b[2], b[3], b[4], b[5]);
+		if (rc == 0 && b[3] == 0x72 && b[4] == 0x66) {
+			break;	/* NT36672A, as in the Android log: 0a 00 00 72 66 03 */
+		}
+	}
+	/* let the firmware run, then wait for reset-complete (>= 0xA0) at event page + 0x60 */
+	tt_nvt_cmd(0x69);
+	tulip_udelay(35000);
+	for (n = 0; n < 100 && !got; n++) {
+		tulip_udelay(10000);
+		for (i = 0; i < sizeof(tt_nvt_pages) / sizeof(tt_nvt_pages[0]); i++) {
+			if (tt_nvt_read(tt_nvt_pages[i] + 0x60, b, 6) == 0 && b[1] >= 0xa0 && b[1] <= 0xaf) {
+				tt_ev_page = tt_nvt_pages[i];
+				got = 1;
+				break;
+			}
+		}
+	}
+	if (got) {
+		rc = tt_nvt_read(tt_ev_page + 0x78, b, 16);
+		printf("TULIP NVT: event page 0x%05x reset state %02x; fwinfo rc %d fw %02x/%02x x_num %u y_num %u "
+		    "max x %u y %u\n", tt_ev_page, b[0], rc, b[0], b[1], b[2], b[3],
+		    (b[4] << 8) | b[5], (b[6] << 8) | b[7]);
+	} else {
+		printf("TULIP NVT: no event page showed a reset state, scanning pages for changes\n");
+	}
 	sweet_console_muted = muted;
 	tt_ready = (found > 0);
 }
