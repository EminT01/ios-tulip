--- a/bsd/dev/tulip_sdhci.c
+++ b/bsd/dev/tulip_sdhci.c
@@ -398,6 +398,18 @@
 	return ok ? 0 : -1;
 }
 
+/*
+ * TULIP 0313: the NT36xxx answers on TWO I2C addresses (stock nt36xxx.c):
+ * 0x62 takes the hardware commands (0x69 boot reset, 0xA5 idle, 0x35), and
+ * 0x01 is the firmware/bootloader address that takes the { 0xFF, page } index
+ * write and every register read. 0280 used 0x62 for both, so it could not read
+ * anything. The sequence below follows the stock probe; decoded fingers go to
+ * sweet_hid_touch() in panel pixels.
+ */
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+static uint32_t tt_ev_page;
+
 static int
 tt_nvt_read(uint32_t addr, uint8_t *buf, int n)
 {
@@ -406,14 +418,24 @@
 	pg[0] = 0xff;
 	pg[1] = (uint8_t)(addr >> 16);
 	pg[2] = (uint8_t)(addr >> 8);
-	if (tt_write(0x62, pg, 3) != 0) {
+	if (tt_write(0x01, pg, 3) != 0) {
 		return -3;
 	}
-	return tt_read(0x62, (uint8_t)(addr & 0xff), buf, n);
+	return tt_read(0x01, (uint8_t)(addr & 0xff), buf, n);
+}
+
+static void
+tt_nvt_cmd(uint8_t cmd)
+{
+	uint8_t c[2];
+
+	c[0] = 0x00;
+	c[1] = cmd;
+	(void)tt_write(0x62, c, 2);
 }
 
 static const uint32_t tt_nvt_pages[] = {
-	0x11e00, 0x21c00, 0x11a00, 0x22d00, 0x2fe00, 0x21000
+	0x11e00, 0x11c00, 0x21c00, 0x11a00, 0x22d00, 0x2fe00, 0x21000
 };
 
 void tulip_touch_poll(void);
@@ -421,11 +443,13 @@
 tulip_touch_poll(void)
 {
 	static uint64_t next_ns;
-	static uint8_t last[6][8];
+	static uint8_t last[8][8];
+	static uint32_t down_mask;
+	static int px[10], py[10];
 	uint64_t ns = 0;
-	uint8_t b[8];
+	uint8_t b[72];
 	size_t i;
-	int muted;
+	int muted, k;
 
 	if (!tt_ready) {
 		return;
@@ -434,8 +458,53 @@
 	if (ns < next_ns) {
 		return;
 	}
+	if (tt_ev_page) {
+		uint32_t mask = 0;
+		int x[10] = {0}, y[10] = {0};
+
+		next_ns = ns + 15000000ULL;
+		if (tt_nvt_read(tt_ev_page, b, 65) != 0) {
+			return;
+		}
+		for (k = 0; k < 10; k++) {
+			const uint8_t *p = &b[6 * k];
+			int id = p[0] >> 3, st = p[0] & 7;
+
+			if (id < 1 || id > 10 || (st != 1 && st != 2)) {
+				continue;
+			}
+			x[id - 1] = (p[1] << 4) | (p[3] >> 4);
+			y[id - 1] = (p[2] << 4) | (p[3] & 0x0f);
+			mask |= 1u << (id - 1);
+		}
+		for (k = 0; k < 10; k++) {
+			if (mask & (1u << k)) {
+				if (!(down_mask & (1u << k)) || x[k] != px[k] || y[k] != py[k]) {
+					sweet_hid_touch(k, 1, x[k], y[k]);
+					if (tt_nvt_lines++ < 300) {
+						muted = sweet_console_muted;
+						sweet_console_muted = 0;
+						printf("TULIP NVT: finger %d down x %d y %d\n", k, x[k], y[k]);
+						sweet_console_muted = muted;
+					}
+				}
+				px[k] = x[k];
+				py[k] = y[k];
+			} else if (down_mask & (1u << k)) {
+				sweet_hid_touch(k, 0, px[k], py[k]);
+				if (tt_nvt_lines++ < 300) {
+					muted = sweet_console_muted;
+					sweet_console_muted = 0;
+					printf("TULIP NVT: finger %d up\n", k);
+					sweet_console_muted = muted;
+				}
+			}
+		}
+		down_mask = mask;
+		return;
+	}
 	next_ns = ns + 300000000ULL;
