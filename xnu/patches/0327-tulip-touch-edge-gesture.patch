+		 * the widget editor on the lock screen cannot be left.
+		 */
+		UInt32 mask = 0;
+		if (fEdge[i]) {
+			mask |= kIOHIDDigitizerEventFromEdgeTip | kIOHIDDigitizerEventFromCorner |
