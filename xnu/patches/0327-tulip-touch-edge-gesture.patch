-		UInt32 mask = fEdge[i] ? kIOHIDDigitizerEventFromEdgeTip : 0;
+		/*
+		 * TULIP 0327: a touch that starts at the edge has to look like an
+		 * edge touch for its whole life, and UIKit reads more than one bit.
+		 * 0071 in the sweet notes: EventMask 0xb0007 carries 0x800 (FromEdgeTip),
+		 * 0x1000 (FromCorner) and 0x40000; without the corner and force bits a
