+
+/*
+ * TULIP 0316: record every Unix syscall and Mach trap of the thread that mapped the BoundingPath
+ * Assets.car (the first 48 and the last 48 after the mmap) and print them when that thread aborts
+ * (__pthread_kill, abort_with_payload or exit). Shows what CoreUI and UIKit ask the kernel for
+ * before they give up: sysctls, stat calls, Mach messages and their return codes.
+ */
+struct tulip_ring_ent {
+	int32_t code;
+	int32_t err;
+	uint64_t a0, a1;
+	char nm[28];
+};
+#define TULIP_RING_FIRST 48
+#define TULIP_RING_LAST 48
+static struct tulip_ring_ent tulip_ring_f[TULIP_RING_FIRST], tulip_ring_l[TULIP_RING_LAST];
+static unsigned tulip_ring_n;
+static volatile int tulip_ring_on;
+static thread_t tulip_ring_th;
+static int tulip_ring_pid;
+
+void tulip_ring_start(void);
+void tulip_ring_add(int code, int err, uint64_t a0, uint64_t a1, const char *nm);
+void tulip_ring_done(int code);
+
+void
+tulip_ring_start(void)
+{
+	tulip_ring_n = 0;
+	tulip_ring_th = current_thread();
+	tulip_ring_pid = proc_getpid(current_proc());
+	tulip_ring_on = 1;
+}
+
+void
+tulip_ring_add(int code, int err, uint64_t a0, uint64_t a1, const char *nm)
+{
+	struct tulip_ring_ent *e;
+	unsigned n;
+
+	if (!tulip_ring_on || current_thread() != tulip_ring_th) {
+		return;
+	}
+	n = tulip_ring_n++;
+	e = (n < TULIP_RING_FIRST) ? &tulip_ring_f[n] : &tulip_ring_l[(n - TULIP_RING_FIRST) % TULIP_RING_LAST];
+	e->code = code;
+	e->err = err;
+	e->a0 = a0;
+	e->a1 = a1;
+	strlcpy(e->nm, nm ? nm : "", sizeof(e->nm));
+}
+
+static void
+tulip_ring_print(unsigned idx, const struct tulip_ring_ent *e)
+{
+	printf("TULIP RING: #%u code %d err %d a0 %llx a1 %llx %s\n", idx, (int)e->code, (int)e->err,
+	    (unsigned long long)e->a0, (unsigned long long)e->a1, e->nm);
+}
+
+void
+tulip_ring_done(int code)
+{
+	unsigned n, i, firstn, lastn;
+
+	if (!tulip_ring_on || proc_getpid(current_proc()) != tulip_ring_pid || (code != 328 && code != 521 && code != 1)) {
+		return;
+	}
+	tulip_ring_on = 0;
+	n = tulip_ring_n;
+	printf("TULIP RING: %u calls after the Assets.car mmap, ended by code %d\n", n, code);
+	firstn = n < TULIP_RING_FIRST ? n : TULIP_RING_FIRST;
+	for (i = 0; i < firstn; i++) {
+		tulip_ring_print(i, &tulip_ring_f[i]);
+	}
+	if (n > TULIP_RING_FIRST) {
+		lastn = n - TULIP_RING_FIRST;
+		if (lastn > TULIP_RING_LAST) {
+			printf("TULIP RING: ... %u calls skipped\n", lastn - TULIP_RING_LAST);
+			lastn = TULIP_RING_LAST;
+		}
+		for (i = n - lastn; i < n; i++) {
+			tulip_ring_print(i, &tulip_ring_l[(i - TULIP_RING_FIRST) % TULIP_RING_LAST]);
+		}
+	}
+}
