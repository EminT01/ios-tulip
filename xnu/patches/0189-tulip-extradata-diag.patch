diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 4c6937a..e4c9f74 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -199,6 +199,20 @@ sweet_early_mark(unsigned int stage, const char *label)
 	sweet_early_putc('\n');
 }
 
+void
+tulip_early_hex(const char *label, uint64_t v)
+{
+	if (early_disabled) {
+		return;
+	}
+	sweet_early_string(label);
+	sweet_early_string(" ");
+	for (int sh = 60; sh >= 0; sh -= 4) {
+		sweet_early_putc("0123456789abcdef"[(v >> sh) & 0xf]);
+	}
+	sweet_early_putc('\n');
+}
+
 void
 sweet_early_panic(const char *fmt, va_list *args)
 {
