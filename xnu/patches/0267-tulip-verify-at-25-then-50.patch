+/*
+ * TULIP 0267: one 512-byte EXT_CSD read at whatever rate the GCC currently
+ * programs, checked against SEC_COUNT. Used to prove the 8-bit data path at
+ * 50 MHz before the root device is exposed; returns 0 only when the block
+ * came back intact.
+ */
+static int
+sdhci_verify_at_50mhz(uint32_t expected_sec_count)
+{
+	uint32_t got = 0;
+	int error;
+
+	dma_sync(SDHCI_BLOCK, TRUE);
+	error = sdhci_read_pio(8, 0, 1, (void *)(se.dma + DMA_BOUNCE));
+	if (error) {
+		printf("TULIP SDHCI: 50 MHz probe: EXT_CSD read failed (%d)\n",
+		    error);
+		return error;
+	}
+	dma_sync(SDHCI_BLOCK, TRUE);
+	memcpy(&got, (const void *)(se.dma + DMA_BOUNCE + 212), 4);
+	if (got != expected_sec_count) {
+		printf("TULIP SDHCI: 50 MHz probe: SEC_COUNT %u != %u, the "
+		    "block did not come back intact\n", got, expected_sec_count);
+		return EIO;
+	}
+	printf("TULIP SDHCI: 50 MHz probe: EXT_CSD read back intact "
+	    "(SEC_COUNT %u)\n", got);
+	return 0;
+}
