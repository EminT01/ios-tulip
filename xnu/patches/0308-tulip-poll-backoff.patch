--- a/bsd/dev/tulip_sdhci.c
+++ b/bsd/dev/tulip_sdhci.c
@@ -1220,6 +1220,7 @@
 sdhci_poll_state(uint32_t mask, uint64_t timeout_ns)
 {
 	uint64_t deadline;
+	uint32_t spins = 0;
 
 	nanoseconds_to_absolutetime(timeout_ns, &deadline);
 	deadline += mach_absolute_time();
@@ -1227,7 +1228,15 @@
 		if (mach_absolute_time() > deadline) {
 			return ETIMEDOUT;
 		}
-		delay(1);
+		/*
+		 * TULIP 0308: CMD_INHIBIT/DATA_INHIBIT normally clear within a
+		 * handful of polls, so the microsecond of busy-wait per spin is
+		 * pure overhead for every command this driver issues. Only back off
+		 * once the state machine is clearly slow.
+		 */
+		if (++spins > 64) {
+			delay(1);
+		}
 	}
 	return 0;
 }
@@ -1323,6 +1332,7 @@
     uint32_t *resp)
 {
 	uint64_t deadline, start;
+	uint32_t spins = 0;
 	int error;
 
 	se.last_cmd_ns = 0;
@@ -1407,7 +1417,15 @@
 			    (unsigned long long)se.last_cmd_ns);
 			return ETIMEDOUT;
 		}
-		delay(1);
+		/*
+		 * TULIP 0308: a command completes in a few microseconds and this
+		 * loop is on the path of every block read, so back off only every
+		 * 100th spin, as sdhci_wait_data does after 0305.
+		 */
+		if ((spins & 0x63u) == 0) {
+			delay(1);
+		}
+		spins++;
 	}
 }
 
