+	setProperty("DisplayPipeIndex", 0ULL, 32);
+	setProperty("IOMFBMaxSrcPixels", (UInt64)(fLogicalW * fLogicalH), 32);
+	setProperty("IOMFBDisplayRefresh", 60ULL, 32);
+	setProperty("IOMFBSupportsLFC", false);
+	setProperty("IOMFBSupportsTcon", false);
+	setProperty("IOMFBSurfaceLateFX", 0ULL, 32);
+	setProperty("IOMFBScanoutLateFX", 0ULL, 32);
+	setProperty("idleCachingMethod", 0ULL, 32);
+	setProperty("IOMFBScalingLats", 0ULL, 32);
 	registerService();
