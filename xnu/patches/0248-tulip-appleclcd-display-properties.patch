--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -275,2 +275,23 @@
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	/*
+	 * TULIP 0248: Redmi Note 6 Pro (tulip, SDM636).
+	 * Panel: Tianma NT36672A, 1080x2280 video mode, 32 bpp BGRA,
+	 *        stride = 1080 * 4 = 4320, framebuffer at 0x9d400000
+	 *        (cont_splash_mem, 36 MiB), 60 Hz.
+	 * backboardd asks AppleCLCD for each of these and gets "none"; without
+	 * DisplayPipeStrideRequirements it never enables the display pipe and
+	 * nothing is ever scanned out, so boot stalls in AppleCLCD::start().
+	 * Use the real panel size: fLogicalW/fLogicalH hold the iPhone X
+	 * values (1125x2436) that are reported to userland, not the panel.
+	 */
+	setProperty("DisplayPipeStrideRequirements", (UInt64)fWidth * 4, 32);
+	setProperty("DisplayPipeIndex", 0ULL, 32);
+	setProperty("IOMFBMaxSrcPixels", (UInt64)fWidth * fHeight, 32);
+	setProperty("IOMFBDisplayRefresh", 60ULL, 32);
+	setProperty("IOMFBSupportsLFC", false);
+	setProperty("IOMFBSupportsTcon", false);
+	setProperty("IOMFBSurfaceLateFX", 0ULL, 32);
+	setProperty("IOMFBScanoutLateFX", 0ULL, 32);
+	setProperty("idleCachingMethod", 0ULL, 32);
+	setProperty("IOMFBScalingLats", 0ULL, 32);
 	registerService();
