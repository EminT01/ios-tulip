diff -U3 -r a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c	2026-11-26 21:32:38.685544908 +0300
+++ b/osfmk/arm64/sleh.c	2026-11-26 21:32:38.686881054 +0300
@@ -1872,6 +1872,19 @@
  */
 volatile uint64_t tulip_soft_ticks;
 volatile uint64_t tulip_soft_tick_next;
+/*
+ * TULIP 0334: why do seven cores report zero idle time?
+ *
+ * HB11 showed "idle ms 74 0 0 0 0 0 0 0" on an 8/8 SMP boot: only the boot CPU
+ * was ever caught inside WFI. cpu_idle() has four ways out of its loop and a
+ * bare zero cannot tell "never scheduled" from "an AST was pending" from "the
+ * arm helper returned 0". Count them separately.
+ */
+volatile uint64_t tulip_idle_enter[8];   /* reached the soft-tick loop */
+volatile uint64_t tulip_idle_wfi[8];     /* WFI executed */
+volatile uint64_t tulip_idle_arm0[8];    /* tulip_soft_tick_arm() returned 0 */
+volatile uint64_t tulip_idle_ast[8];     /* left, AST pending */
+volatile uint64_t tulip_idle_sigp[8];    /* left, SIGPdisabled */
 
