@@ -241,15 +241,32 @@
 	    b[21], b[22], b[23]);
 }
 
+static int tt_spin;	/* touchprobe=2: poll without tsleep (busy wait) */
+
 static void
-tulip_touch_thread(void *arg, wait_result_t w)
+tt_nap(int ticks)
 {
 	static int chan;
+
+	if (tt_spin) {
+		uint64_t ms = (uint64_t)ticks * 1000 / (uint64_t)hz;
+
+		while (ms--) {
+			tulip_udelay(1000);
+		}
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "tulipts", ticks);
+}
+
+static void
+tulip_touch_thread(void *arg, wait_result_t w)
