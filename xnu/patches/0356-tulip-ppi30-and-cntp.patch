diff -U3 -r a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp	2026-11-27 22:07:13.288058450 +0300
+++ b/iokit/Kernel/arm/SweetCPU.cpp	2026-11-27 22:07:13.289351506 +0300
@@ -109,23 +109,26 @@
 	*(volatile uint32_t *)(rd + GICR_ISENABLER0) =
 	    (1U << vince_vtimer_intid) | (1U << VINCE_IPI_SGI);
 	/*
-	 * TULIP 0321: keep the physical timer PPI away from the secondaries.
+	 * TULIP 0356: keep the physical timer PPI enabled here, like every other
+	 * core.
 	 *
-	 * This function is only called from initCPU()s !fBoot path, so every
-	 * frame it touches belongs to a secondary core. pe_init_fiq() enables
-	 * PPI 30 as well when it brings the boot CPU frame up, and that enable
-	 * survives on the redistributor: HB7 showed CPU1 taking 12 million timer
-	 * interrupts in 44 seconds while a healthy core sits near a thousand,
-	 * and HB8 put the deadline 0.8 ms in the past there. This function only
-	 * ever enabled the virtual timer PPI and SGI1, so the physical one was
-	 * inherited from the boot CPU rather than asked for.
+	 * 0321 cleared bit 30 on the secondaries because HB7 showed CPU1 taking 12
+	 * million timer interrupts in 44 s. That reading was right but the cure
+	 * was not: HB16 now shows the secondaries with enab 0x00480002 (no PPI 30)
+	 * and pend 0x40200000 - INTID 30 pending, permanently, on every core. WFI
+	 * wakes on a pending interrupt even when the GIC has it disabled, so the
+	 * core enters the IRQ vector, ICC_IAR1_EL1 returns 1023 (spurious), nothing
+	 * acknowledges it and the bit never clears. HB2 counts 30873 of those, HB7
+	 * gives cpu4..cpu7 a few thousand timer interrupts where cpu1 has 80
+	 * thousand, and the scheduler quanta fall apart - with the boot work all
+	 * landing on the two cores that do get interrupts.
 	 *
-	 * Write GICR_ICENABLER0 bit 30 here and let cpu_idle()s software tick
-	 * (0286) be the clock on the secondaries, which is the configuration
-	 * that ran this device without a storm. The boot CPU keeps PPI 30, and
-	 * 0320 still arms CNTV as the primary source on every core.
+	 * The storm 0321 was chasing came from 0320 arming CNTP with a fixed
+	 * deadline computed from a counter that had already expired (HB8: cval-ct
+	 * -77905). 0356 fixes that at the source in sleh.c by arming CNTP from
+	 * XNU's own rtcPop, so the PPI can stay enabled.
 	 */
-	*(volatile uint32_t *)(rd + GICR_ICENABLER0) = (1U << 30);
+	__asm__ volatile ("" ::: "memory");
 	__builtin_arm_dsb(DSB_SY);
 
 	/*
diff -U3 -r a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c	2026-11-27 22:07:13.292508779 +0300
+++ b/osfmk/arm64/sleh.c	2026-11-27 22:07:13.294493496 +0300
@@ -2064,8 +2064,33 @@
 			}
 			__builtin_arm_wsr64("CNTV_CVAL_EL0", vcv);
 			__builtin_arm_wsr64("CNTV_CTL_EL0", 1);
-			__builtin_arm_wsr64("CNTP_CVAL_EL0", vcv);
-			__builtin_arm_wsr64("CNTP_CTL_EL0", 1);
+			/*
+			 * TULIP 0356: CNTP takes XNU's own deadline, not a copy of the
+			 * virtual timer's.
+			 *
+			 * 0320 wrote the CNTV deadline into CNTP as well, under the
+			 * assumption that the PPI this GIC actually delivers is the
+			 * physical one. HB16 shows it is not: with PPI 30 enabled the
+			 * hardware path works, and every core that got a real timer
+			 * interrupt ran the normal handler. What broke was the deadline:
+			 * HB8 caught cval-ct at -77905, a value already in the past, so
+			 * the PPI stayed pending and the core interrupted itself forever.
+			 *
+			 * cpu_decrementer is where XNU keeps the next deadline for this
+			 * core (rtclock_intr sets it). Arm CNTP from that when it is ahead
+			 * of the counter, and leave CNTP alone otherwise - an unarmed
+			 * timer cannot storm.
+			 */
+			{
+				int64_t pop = (int64_t)cdp->rtcPop;
+
+				if (pop > (int64_t)now) {
+					__builtin_arm_wsr64("CNTP_CVAL_EL0", (uint64_t)pop);
+					__builtin_arm_wsr64("CNTP_CTL_EL0", 1);
+				} else {
+					__builtin_arm_wsr64("CNTP_CTL_EL0", 0);
+				}
+			}
 			__builtin_arm_isb(ISB_SY);
 
 			if (*cnt == 200000 && !tulip_storm_set) {
