+#if defined(VINCE_GIC_V3)
+extern "C" volatile uint32_t tulip_sgi_seen[16];
+extern "C" volatile uint32_t tulip_sgi_mask;
+
+/*
+ * TULIP 0297: SGI1 never arrives (self-test timed out). Send each of SGI 0-15 to this
+ * CPU in turn and record which ones come back, so the log says which SGIs the
+ * TrustZone-split GIC lets EL1 use. Returns a bit mask.
+ */
+static uint32_t
+tulip_sgi_sweep(uint64_t mpidr)
+{
+	uint32_t mask = 0;
+	vm_offset_t rd = vince_gicr_for(mpidr);
+
+	if (rd) {
+		*(volatile uint32_t *)(rd + GICR_ISENABLER0) = 0xffff;
+		__builtin_arm_dsb(DSB_SY);
+	}
+	for (unsigned int n = 0; n < 16; n++) {
+		uint32_t before = tulip_sgi_seen[n];
+		uint64_t deadline;
+		uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+		    (((mpidr >> 16) & 0xff) << 32) |
+		    (((mpidr >> 8) & 0xff) << 16) |
+		    ((uint64_t)n << 24) | (1ULL << (mpidr & 0xf));
+
+		nanoseconds_to_deadline(5 * 1000 * 1000, &deadline);
+		__builtin_arm_dsb(DSB_ISHST);
+		__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+		__builtin_arm_isb(ISB_SY);
+		while (tulip_sgi_seen[n] == before && mach_absolute_time() < deadline) {
+			__asm__ volatile ("yield");
+		}
+		if (tulip_sgi_seen[n] != before) {
+			mask |= 1U << n;
+		}
+	}
+	tulip_sgi_mask = mask | 0x80000000U;
+	return mask;
+}
+#endif /* VINCE_GIC_V3 */
