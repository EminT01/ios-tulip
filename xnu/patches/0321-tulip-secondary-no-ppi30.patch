@@ -86,16 +90,34 @@
 		}
 	}
 	*(volatile uint32_t *)(rd + GICR_IGROUPR0) = 0xffffffff;
 	for (unsigned int i = 0; i < 32; i++) {
 		*(volatile uint8_t *)(rd + GICR_IPRIORITYR0 + i) = 0xa0;
 	}
 	*(volatile uint32_t *)(rd + GICR_ISENABLER0) =
 	    (1U << vince_vtimer_intid) | (1U << VINCE_IPI_SGI);
+	/*
+	 * TULIP 0321: keep the physical timer PPI away from the secondaries.
+	 *
+	 * This function is only called from initCPU()s !fBoot path, so every
+	 * frame it touches belongs to a secondary core. pe_init_fiq() enables
+	 * PPI 30 as well when it brings the boot CPU frame up, and that enable
+	 * survives on the redistributor: HB7 showed CPU1 taking 12 million timer
+	 * interrupts in 44 seconds while a healthy core sits near a thousand,
+	 * and HB8 put the deadline 0.8 ms in the past there. This function only
+	 * ever enabled the virtual timer PPI and SGI1, so the physical one was
+	 * inherited from the boot CPU rather than asked for.
+	 *
+	 * Write GICR_ICENABLER0 bit 30 here and let cpu_idle()s software tick
+	 * (0286) be the clock on the secondaries, which is the configuration
+	 * that ran this device without a storm. The boot CPU keeps PPI 30, and
+	 * 0320 still arms CNTV as the primary source on every core.
+	 */
+	*(volatile uint32_t *)(rd + GICR_ICENABLER0) = (1U << 30);
 	__builtin_arm_dsb(DSB_SY);
 }
