+		absolutetime_to_nanoseconds(mach_absolute_time(), &hb_ns);
+		if (hb_ns >= hb_next_ns) {
+			hb_next_ns = hb_ns + 20000000000ULL;
+			printf("TULIP HB: up %llu s, sampler stage %d wakes %llu, eMMC reads %llu\n",
+			    hb_ns / 1000000000ULL, sweet_sample_stage,
+			    (unsigned long long)sweet_sample_wakes,
