 	}
 	tulip_perf_emmc_ticks += mach_absolute_time() - perf_t0;
+	{
+		/* TULIP 0274: heartbeat every 20 s from the disk path (needs no timer sleep) */
+		static uint64_t hb_next_ns;
+		extern volatile int sweet_sample_stage;
+		extern volatile uint64_t sweet_sample_wakes;
