+/*
+ * TULIP 0331: one synthetic home swipe.
+ *
+ * A home gesture has to begin inside the bottom edge band (SWEET_TOUCH_EDGE_PX
+ * above the last row) because only there does touch() set the edge bits UIKit
+ * reads. Start at panel height - 10 and lift at roughly a third of the panel,
+ * well past the unlock threshold, in twelve steps.
+ */
+void
+SweetHIDTouch::swipeFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDTouch *self = (SweetHIDTouch *)owner;
+	const int steps = 12;
+	const int yStart = SWEET_TOUCH_PANEL_H - 10;
+	const int yEnd = SWEET_TOUCH_PANEL_H / 3;
+	const int xMid = 540;
+	int step = self->fSwipeStep;
+
+	if (step < 0) {
+		self->fSwipeStep = step = 0;
+		IOLog("TULIP HID: synthetic swipe %u from y %d to %d\n",
+		    self->fSwipeCount + 1, yStart, yEnd);
+	}
+	if (step == 0) {
+		self->touch(0, true, xMid, yStart);
+	} else if (step <= steps) {
+		int y = yStart - (step * (yStart - yEnd)) / steps;
+		self->touch(0, true, xMid, y);
+	} else {
+		self->touch(0, false, xMid, yEnd);
+		self->fSwipeStep = -1;
+		if (++self->fSwipeCount < 30) {
+			IOLog("TULIP HID: synthetic swipe %u sent, next in %u s\n",
+			    self->fSwipeCount, self->fSwipeSecs);
+			sender->setTimeoutMS(self->fSwipeSecs * 1000);
+		}
+		return;
+	}
+	self->fSwipeStep++;
+	sender->setTimeoutMS(25);
+}
