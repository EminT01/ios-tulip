--- a/bsd/dev/tulip_sdhci.c
+++ b/bsd/dev/tulip_sdhci.c
@@ -2794,15 +2794,30 @@
 	const char *name = r->name;
 	uint32_t mhz = 0;
 	uint64_t deadline;
+	bool want50;
+
+	/*
+	 * TULIP 0306: read the boot-arg before looking at the mapping. The old
+	 * order returned silently when tulip_sdc1_va was NULL, so a missing
+	 * mapping swallowed sdcmhz=50 without a word and the card stayed at
+	 * 25 MHz. Report that case instead of vanishing.
+	 */
+	want50 = (r == &tulip_gcc_rates[TULIP_GCC_RATE_25M]) &&
+	    PE_parse_boot_argn("sdcmhz", &mhz, sizeof(mhz)) && mhz == 50;
 
 	if (g == NULL) {
+		printf("TULIP SDHCI: sdcc1 page not mapped (tulip_sdc1_va NULL), "
+		    "cannot set %s (sdcmhz=50 requested: %u)\n",
+		    want50 ? "50 MHz" : r->name, want50 ? 1u : 0u);
 		return;
 	}
-	if (r == &tulip_gcc_rates[TULIP_GCC_RATE_25M] &&
-	    PE_parse_boot_argn("sdcmhz", &mhz, sizeof(mhz)) && mhz == 50) {
+	if (want50) {
 		cfg = 0x011fu;
 		name = "50 MHz";
 	}
+	printf("TULIP SDHCI: sdcc1_set_rate %s (M 0x%02x N 0x%02x D 0x%02x "
+	    "CFG 0x%04x, page %p)\n", name, r->m, r->n, r->d, cfg,
+	    (void *)g);
 	g[TULIP_SDC1_RCG_M / 4] = r->m;
 	g[TULIP_SDC1_RCG_N / 4] = r->n;
 	g[TULIP_SDC1_RCG_D / 4] = r->d;
