 /* TULIP 0279: interrupt counters shown by the TULIP HB2 line */
 volatile uint64_t tulip_irq_timer, tulip_irq_ipi, tulip_irq_other, tulip_irq_spur;
+
+#if defined(VINCE_TULIP)
+/*
+ * TULIP 0286/0287: soft tick source, because no timer interrupt is delivered.
+ *
+ * 0282/0283/0284 measured the same thing three times: CNTV is armed and
+ * expired (CTL 0x5, CVAL in the past), GICR_ISPENDR0 reports PPI 30 pending,
+ * and GICR_ISENABLER0 still reads back 0x0 after every write - TrustZone keeps
+ * the PPIs, so nothing reaches EL1.
+ *
+ * 0286 polled this from cpu_idle() before the WFI, but cpu_idle runs the poll
+ * once and then sleeps in WFI forever, so the counter stayed at zero for the
+ * whole boot. 0287 polls from inside a bounded WFI window instead: arm the
+ * virtual timer a period out, WFI, wake, deliver what is due, repeat.
+ *
+ * 100 Hz matches the VINCE config; CNTFRQ is read rather than assumed.
+ */
+volatile uint64_t tulip_soft_ticks;
+volatile uint64_t tulip_soft_tick_next;
+
+int
+tulip_soft_tick_due(void)
+{
+	uint64_t now, freq, next;
+
+	__asm__ volatile ("mrs %0, cntvct_el0" : "=r"(now));
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(freq));
+	if (freq == 0) {
+		return 0;
+	}
+	if (tulip_soft_tick_next == 0) {
+		tulip_soft_tick_next = now + freq / 100;
+		return 0;
+	}
+	if (now < tulip_soft_tick_next) {
+		return 0;
+	}
+	next = tulip_soft_tick_next + freq / 100;
+	/* Do not fall behind by more than one tick after a long stall. */
+	if (next < now) {
+		next = now + freq / 100;
+	}
+	tulip_soft_tick_next = next;
+	tulip_soft_ticks++;
+	return 1;
+}
+
+/*
+ * TULIP 0287: arm CNTV one period ahead and return the raw comparable value,
+ * so cpu_idle can bound its WFI. Even though the interrupt never arrives, the
+ * counter still expires and cpu_idle re-checks after every WFI wakeup; the
+ * bounded window is what stops it from sleeping through the whole boot.
+ */
+uint64_t
+tulip_soft_tick_arm(void)
+{
+	uint64_t now, freq, deadline;
+
+	__asm__ volatile ("mrs %0, cntvct_el0" : "=r"(now));
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(freq));
+	if (freq == 0) {
+		return 0;
+	}
+	deadline = now + freq / 100;
+	__builtin_arm_wsr64("CNTV_CVAL_EL0", deadline);
+	__builtin_arm_wsr64("CNTV_CTL_EL0", 1);
+	__builtin_arm_isb(ISB_SY);
+	if (tulip_soft_tick_next == 0) {
+		tulip_soft_tick_next = deadline;
+	}
+	return deadline;
+}
+#endif /* VINCE_TULIP */
 volatile uint32_t tulip_irq_lastother;
 
