--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1893,6 +1893,31 @@
 	tulip_soft_ticks++;
 	return 1;
 }
+
+/*
+ * TULIP 0287: arm CNTV one period ahead and return that absolute value, so
+ * cpu_idle can bound its WFI window. The interrupt never arrives on this SoC,
+ * so the window - not the interrupt - is what wakes the core back up.
+ */
+uint64_t
+tulip_soft_tick_arm(void)
+{
+	uint64_t now, freq, deadline;
+
+	__asm__ volatile ("mrs %0, cntvct_el0" : "=r"(now));
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(freq));
+	if (freq == 0) {
+		return 0;
+	}
+	deadline = now + freq / 100;
+	__builtin_arm_wsr64("CNTV_CVAL_EL0", deadline);
+	__builtin_arm_wsr64("CNTV_CTL_EL0", 1);
+	__builtin_arm_isb(ISB_SY);
+	if (tulip_soft_tick_next == 0) {
+		tulip_soft_tick_next = deadline;
+	}
+	return deadline;
+}
 #endif /* VINCE_TULIP */
