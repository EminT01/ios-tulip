--- a/bsd/dev/tulip_sdhci.c	2026-11-26 23:09:25.192517811 +0300
+++ b/bsd/dev/tulip_sdhci.c	2026-11-26 23:09:25.194480732 +0300
@@ -686,6 +686,46 @@
 #define SDHCI_TRNS_READ         0x0010
 #define SDHCI_TRNS_MULTI        0x0020
 
+/*
+ * TULIP 0338: ADMA2 reads.
+ *
+ * Every block read on this board goes through SDMA or PIO because an early
+ * boot got ADMAERR on the first data command after CMD0 and the path was
+ * dropped. whyred - the same SDCC v5 core on the same SoC family - added
+ * ADMA2 in 0210 and ships it behind a self-test, with a 32-bit descriptor
+ * table that has to sit below 4 GiB.
+ *
+ * Here it is opt-in: tulipadma=1 turns it on and the default keeps the working
+ * SDMA/PIO path. The table lives in the last 4 KiB of the bounce buffer, which
+ * the kernel image provides and which is below 4 GiB; a table above that limit
+ * is a silent ADMAERR, the failure to avoid.
+ */
+#define SDHCI_ADMA_SYS_ADDR     0x58
+#define SDHCI_ADMA_SYS_ADDR_HI  0x5c
+#define SDHCI_ADMA_ERR          0x54
+#define SDHCI_CTRL_ADMA2_32     0x08u
+#define ADMA_ATTR_VALID         0x0001u
+#define ADMA_ATTR_END           0x0002u
+#define ADMA_ATTR_TRAN          0x0020u         /* Act = 10: transfer data */
+#define ADMA_CHUNK              32768u          /* explicit length, < 64 KiB */
+#define ADMA_FAIL_LIMIT         3u
+#define ADMA_TABLE_OFF          (BOUNCE_SIZE - 4096u)
+#define ADMA_TEST_BLOCKS        256u            /* 128 KiB */
+#define ADMA_TEST_LBA           0ull
+#define ADMA_TEST_TMP_OFF       0x100000ull     /* 1 MiB into the bounce buffer */
+
+struct tulip_adma2_desc {
+	uint16_t attr;
+	uint16_t len;
+	uint32_t addr;
+} __attribute__((packed));
+
+static volatile struct tulip_adma2_desc *tulip_adma_tbl;
+static uint64_t tulip_adma_tbl_pa;
+static bool tulip_adma_on;
+static uint32_t tulip_adma_fails;
+static uint64_t tulip_adma_reads, tulip_adma_bytes, tulip_adma_ns;
+
 #define SDHCI_CMD_RESP_LONG     0x01
 #define SDHCI_CMD_RESP_SHORT    0x02
 #define SDHCI_CMD_RESP_SHORT_BUSY 0x03
@@ -1150,6 +1190,9 @@
  * after which the transfer never starts - no DATA_TIMEOUT, no DAT activity and
  * CMD_INHIBIT stays set, which is exactly the wedge every boot shows.
