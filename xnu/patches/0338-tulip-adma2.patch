+
+/*
+ * TULIP 0338: put the descriptor table in the bounce buffer's last 4 KiB and
+ * prove ADMA2 works before the filesystem trusts it.
+ */
+static void
+tulip_adma_init(void)
+{
+	int want = 0;
+	uint64_t dma_pa, tmp_pa;
+	char *pio_buf, *dma_buf;
+	uint32_t bytes = ADMA_TEST_BLOCKS * SDHCI_BLOCK;
+	int perr, derr;
+	bool same;
+
+	PE_parse_boot_argn("tulipadma", &want, sizeof(want));
+	if (!want) {
+		return;
+	}
+	if (se.dma == 0 || se.dma_pa == 0) {
+		printf("TULIP SDHCI: ADMA2 skipped, no bounce buffer\n");
+		return;
+	}
+	dma_pa = se.dma_pa + ADMA_TABLE_OFF;
+	if (dma_pa + 4096 > 0x100000000ull) {
+		printf("TULIP SDHCI: ADMA2 skipped, descriptor table at 0x%llx is "
+		    "above the 32-bit ADMA2 window\n", (unsigned long long)dma_pa);
+		return;
+	}
+	tulip_adma_tbl = (volatile struct tulip_adma2_desc *)(se.dma + ADMA_TABLE_OFF);
+	tulip_adma_tbl_pa = dma_pa;
+	tulip_adma_on = true;
+	printf("TULIP SDHCI: ADMA2 descriptor table at pa 0x%llx\n",
+	    (unsigned long long)dma_pa);
+
+	/*
+	 * Self-test: read the same 128 KiB twice, once through PIO and once
+	 * through ADMA2, into two halves of the bounce buffer, and compare.
+	 * Anything but byte-identical leaves ADMA2 off for the whole boot.
+	 */
+	pio_buf = (char *)(se.dma + DMA_BOUNCE);
+	dma_buf = (char *)(se.dma + ADMA_TEST_TMP_OFF);
+	tmp_pa = se.dma_pa + ADMA_TEST_TMP_OFF;
+	memset(dma_buf, 0x5a, bytes);
+
+	perr = sdhci_read_pio_once(18, (uint32_t)ADMA_TEST_LBA, ADMA_TEST_BLOCKS,
+	    pio_buf);
+	derr = sdhci_read_adma(18, (uint32_t)ADMA_TEST_LBA, ADMA_TEST_BLOCKS,
+	    tmp_pa);
+	same = (perr == 0 && derr == 0 && memcmp(pio_buf, dma_buf, bytes) == 0);
+	printf("TULIP SDHCI: ADMA2 self-test: PIO %d, ADMA2 %d, data %s\n",
+	    perr, derr, same ? "IDENTICAL" : "DIFFERENT");
+	if (!same) {
+		tulip_adma_on = false;
+		printf("TULIP SDHCI: ADMA2 read path left OFF (self-test failed)\n");
+		return;
+	}
+	printf("TULIP SDHCI: ADMA2 read path ON\n");
+}
