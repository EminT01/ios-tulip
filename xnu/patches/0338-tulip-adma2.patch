 static inline void
 sdhci_set_block(uint32_t count)
 {
@@ -1995,6 +2038,126 @@
  * For multi-block reads (count > 1), CMD18 is used with AUTO_CMD12 so the
  * host controller automatically terminates the streaming data transfer.
  */
+
+/*
+ * TULIP 0338: one ADMA2 block read into a physical buffer.
+ *
+ * Descriptors are 32-bit ADMA2 (Act = 10, explicit length), chained in a table
+ * inside the bounce buffer. Both the table and the destination are flushed to
+ * memory before the controller is pointed at them - the SDCC core does not
+ * snoop the CPU caches.
+ */
+static int
+sdhci_read_adma(uint8_t index, uint32_t arg, uint32_t count, uint64_t pa)
+{
+	volatile struct tulip_adma2_desc *d = tulip_adma_tbl;
+	uint32_t bytes = count * SDHCI_BLOCK;
+	uint32_t n = 0, off = 0;
+	uint16_t tr_mode;
+	uint8_t ctrl;
+	uint32_t r1 = 0;
+	uint64_t start, deadline, ns;
+	int error;
+
+	if (!tulip_adma_on || d == NULL || count == 0 ||
+	    count > BOUNCE_SIZE / SDHCI_BLOCK || pa + bytes > 0x100000000ull) {
+		return EINVAL;
+	}
+	while (off < bytes) {
+		uint32_t chunk = bytes - off;
+
+		if (chunk > ADMA_CHUNK) {
+			chunk = ADMA_CHUNK;
+		}
+		d[n].attr = (uint16_t)(ADMA_ATTR_VALID | ADMA_ATTR_TRAN |
+		    ((off + chunk == bytes) ? ADMA_ATTR_END : 0));
+		d[n].len = (uint16_t)chunk;
+		d[n].addr = (uint32_t)(pa + off);
+		n++;
+		off += chunk;
+	}
+	flush_dcache64((addr64_t)tulip_adma_tbl_pa, n * sizeof(*d), TRUE);
+	flush_dcache64((addr64_t)pa, bytes, TRUE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	hc_wr(SDHCI_ADMA_SYS_ADDR, (uint32_t)tulip_adma_tbl_pa);
+	hc_wr(SDHCI_ADMA_SYS_ADDR_HI, (uint32_t)(tulip_adma_tbl_pa >> 32));
+	ctrl = hc_rd8(SDHCI_HOST_CONTROL);
+	hc_wr8(SDHCI_HOST_CONTROL,
+	    (uint8_t)((ctrl & ~SDHCI_CTRL_DMA_MASK) | SDHCI_CTRL_ADMA2_32));
+
+	if (index == 18 && count == 1) {
+		index = 17;
+	} else if (index == 17 && count > 1) {
+		index = 18;
+	}
+	sdhci_set_block(count);
+
+	tr_mode = (uint16_t)(SDHCI_TRNS_DMA | SDHCI_TRNS_READ |
+	    SDHCI_TRNS_BLK_CNT_EN);
+	if (index == 18) {
+		tr_mode |= SDHCI_TRNS_MULTI | SDHCI_TRNS_AUTO_CMD12;
+	}
+	tulip_data_moved = false;
+	tulip_sdma_active = false;
+	start = mach_absolute_time();
+	error = sdhci_cmd(index, arg, tr_mode,
+	    SDHCI_CMD_RESP_SHORT | SDHCI_CMD_CRC | SDHCI_CMD_INDEX |
+	    SDHCI_CMD_DATA, &r1);
+	if (!error) {
+		nanoseconds_to_deadline(DATA_TIMEOUT_NS, &deadline);
+		for (;;) {
+			uint32_t st = hc_rd(SDHCI_INT_STATUS);
+
+			if (st & (SDHCI_INT_ERR | SDHCI_INT_DATA_TIMEOUT |
+			    SDHCI_INT_DATA_CRC | SDHCI_INT_ADMAERR)) {
+				printf("TULIP SDHCI: ADMA2 failed: INT_STATUS 0x%08x "
+				    "ADMA_ERR 0x%08x ADMA_ADDR 0x%08x,%08x "
+				    "(%u blocks at LBA 0x%x)\n", st,
+				    hc_rd(SDHCI_ADMA_ERR),
+				    hc_rd(SDHCI_ADMA_SYS_ADDR_HI),
+				    hc_rd(SDHCI_ADMA_SYS_ADDR), count, arg);
+				hc_wr(SDHCI_INT_STATUS, st);
+				error = EIO;
+				break;
+			}
+			if (st & SDHCI_INT_TC) {
+				hc_wr(SDHCI_INT_STATUS, SDHCI_INT_TC);
+				break;
+			}
+			if (mach_absolute_time() >= deadline) {
+				sdhci_data_failure("ADMA2 block", st);
+				error = ETIMEDOUT;
+				break;
+			}
+		}
+	}
+	/* Leave HOST_CONTROL the way the PIO/SDMA paths expect it. */
+	hc_wr8(SDHCI_HOST_CONTROL, (uint8_t)(ctrl & ~SDHCI_CTRL_DMA_MASK));
+	if (error) {
+		sdhci_recover(index == 18);
+		return error;
+	}
+	flush_dcache64((addr64_t)pa, bytes, TRUE);
+	ns = mach_absolute_time() - start;
+	absolutetime_to_nanoseconds(ns, &ns);
+	tulip_adma_reads++;
+	tulip_adma_bytes += bytes;
+	tulip_adma_ns += ns ? ns : 1;
+	if (tulip_adma_reads <= 3 || (tulip_adma_reads % 2048) == 0) {
+		printf("TULIP SDHCI: ADMA2 read #%llu: %u blocks in %llu us; "
+		    "total %llu KiB in %llu ms = %llu KiB/s\n",
+		    (unsigned long long)tulip_adma_reads, count,
+		    (unsigned long long)(ns / 1000),
+		    (unsigned long long)(tulip_adma_bytes >> 10),
+		    (unsigned long long)(tulip_adma_ns / 1000000),
+		    (unsigned long long)((tulip_adma_bytes >> 10) *
+		    1000000000ull / tulip_adma_ns));
+	}
+	return 0;
+}
+
+
 static int
 sdhci_read_pio_once(uint8_t index, uint32_t arg, uint32_t count, void *buf)
 {
@@ -2154,6 +2317,66 @@
  * the controller's DMA engine, so it is the path the hardware is known to
  * complete even if this core never raises Buffer Read Ready for PIO.
