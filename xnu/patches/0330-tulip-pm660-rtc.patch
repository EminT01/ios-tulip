@@ -390,10 +390,22 @@
 #endif
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern "C" long tulip_rtc_gmt(void);
+#define IOPE_GMT_HOOK tulip_rtc_gmt()
+#else
+#define IOPE_GMT_HOOK 0
+#endif
+
 long
 IOPlatformExpert::getGMTTimeOfDay(void)
 {
-	return 0;
+	/*
+	 * TULIP 0330: this used to return 0, so the calendar always started at
+	 * 1970 and every daemon scheduled against a wrong clock. Read the PM660
+	 * RTC through the SPMI arbiter instead.
+	 */
+	return IOPE_GMT_HOOK;
 }
 
