+/* TULIP: who is terminating pid 1? One line of raw return addresses. */
+extern unsigned OSBacktrace(void **bt, unsigned maxAddrs);
+static void
+tulip_report_init_kill(const char *what)
+{
+	void *bt[12] = { 0 };
+	unsigned n = OSBacktrace(bt, 12), i;
+
+	printf("TULIP KILL: %s on pid 1, callers:", what);
+	for (i = 0; i < n; i++) {
+		printf(" %lx", (unsigned long)bt[i] & 0xfffffffffffUL);
+	}
+	printf("\n");
+}
