diff -U3 -r a/bsd/dev/tulip_sdhci.c b/bsd/dev/tulip_sdhci.c
--- a/bsd/dev/tulip_sdhci.c	2026-11-27 21:18:28.860509965 +0300
+++ b/bsd/dev/tulip_sdhci.c	2026-11-27 21:18:28.861526497 +0300
@@ -5376,7 +5376,13 @@
  * WFI loop (osfmk/arm64/cpu.c); the benchmark buffer is for HB11 below.
  */
 uint64_t tulip_idle_ticks[8], tulip_idle_wakes[8];
-static uint64_t tulip_bench_buf[512 * 1024];    /* 4 MiB */
+/*
+ * TULIP 0354: 4 MiB of static BSS was too much for this kernel image and the
+ * benchmark never printed a line - either the block was not mapped or the
+ * measurement never finished. 512 KiB still covers both L1 and L2 on a Kryo
+ * 260 and keeps the footprint small enough to be safely mapped.
+ */
+static uint64_t tulip_bench_buf[64 * 1024];     /* 512 KiB */
 static int tulip_bench_done;
 
 static int
@@ -5520,24 +5526,52 @@
 				if (!tulip_bench_done) {
 					uint64_t t0, t1, t2, x = 1, sum = 0;
 					unsigned i, pass;
+					const unsigned elems = (unsigned)(sizeof(tulip_bench_buf) / sizeof(tulip_bench_buf[0]));
+					const unsigned passes = 8;
+					unsigned first = 0, last = 0;
 
 					tulip_bench_done = 1;
-					/* TULIP 0353: cntpct_el0 is garbage here (HB13); mach time matches a stopwatch */
+					/*
+					 * TULIP 0354: say the benchmark is starting before it runs.
+					 * The old version set the flag, spent its whole budget and
+					 * printed one line at the end; if anything went wrong in
+					 * between there was no trace at all, which is exactly what
+					 * the last boots showed.
+					 */
+					printf("TULIP HB18: bench start alu 20M steps, mem %u KiB x %u passes\n",
+					    (elems * sizeof(tulip_bench_buf[0])) >> 10, passes);
+					/*
+					 * TULIP 0353: cntpct_el0 reads garbage on this core (HB13
+					 * showed 960e12 where the wall clock said 54 s), so use
+					 * mach_absolute_time(), which the stopwatch agrees with.
+					 */
 					t0 = mach_absolute_time();
 					for (i = 0; i < 20000000; i++) {
 						x = x * 3 + i;
 						__asm__ volatile ("" : "+r"(x));
 					}
 					t1 = mach_absolute_time();
-					for (pass = 0; pass < 8; pass++) {
-						for (i = 0; i < 512 * 1024; i++) {
+					/*
+					 * Touch the first and last element of every pass: a buffer
+					 * that is not mapped faults here instead of half way
+					 * through with nothing printed.
+					 */
+					for (pass = 0; pass < passes; pass++) {
+						for (i = 0; i < elems; i++) {
 							sum += tulip_bench_buf[i] + i;
 							tulip_bench_buf[i] = sum;
 						}
+						if (pass == 0) {
+							first = (unsigned)tulip_bench_buf[0];
+						}
+						last = (unsigned)tulip_bench_buf[elems - 1];
 					}
 					t2 = mach_absolute_time();
-					printf("TULIP HB11: bench alu 20M steps %llu us (x %llu), mem 32 MiB rd+wr %llu us (sum %llu)\n",
-					    (t1 - t0) * 1000 / 19200, x & 1, (t2 - t1) * 1000 / 19200, sum & 1);
+					printf("TULIP HB18: bench alu 20M %llu us (x %u) mem %u KiB x %u %llu us "
+					    "(first %u last %u)\n",
+					    (t1 - t0) * 1000 / 19200, (unsigned)(x & 1),
+					    (elems * sizeof(tulip_bench_buf[0])) >> 10, passes,
+					    (t2 - t1) * 1000 / 19200, first, last);
 				}
 			}
