+#if defined(VINCE_TULIP)
+				{
+					/*
+					 * TULIP 0288: the shim's own diag on this board
+					 * (same core, same GIC) prints IRQS 9 / LASTID 19,
+					 * so the timer does reach EL1 before XNU runs.
+					 * pe_init_fiq() is the only GIC setup in the kernel
+					 * and runs very early; 0283/0284 then read back
+					 * GICR_ISENABLER0 0x0 and GICR_ISPENDR0 never shows
+					 * bit 19. Re-arm the PPI here, where printf works,
+					 * and print what the redistributor kept.
+					 */
+					extern vm_offset_t vince_gicr_base;
+					uintptr_t rd = (uintptr_t)vince_gicr_base;
+					if (rd != 0) {
+						volatile uint32_t *waker =
+						    (volatile uint32_t *)(rd + 0x14);
+						volatile uint32_t *isen =
+						    (volatile uint32_t *)(rd + 0x10100);
+						volatile uint32_t *pend =
+						    (volatile uint32_t *)(rd + 0x10200);
+						uint32_t w0 = *waker;
+						uint32_t i0 = *isen;
+
+						if (w0 & 0x4) {
+							*waker = w0 & ~0x2u;
+							for (int i = 0; i < 100000 &&
+							    (*waker & 0x4); i++) {
+								;
+							}
+						}
+						*isen = (1u << 19) | (1u << 1);
+						__builtin_arm_isb(0xf);
+						printf("TULIP GIC288: waker 0x%08x->0x%08x "
+						    "isen 0x%08x->0x%08x pend 0x%08x\n",
+						    w0, *waker, i0, *isen, *pend);
+					} else {
+						printf("TULIP GIC288: gicr base NULL\n");
+					}
+				}
+#endif
 			}
