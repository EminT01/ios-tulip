 #define delay(us) tulip_udelay(us)
 
+/*
+ * TULIP 0271: FocalTech FTS touch probe (boot-arg touchprobe=1, otherwise inert).
+ * Hardware from the live DTB: i2c@c175000 / focaltech@38, SDA GPIO 2, SCL
+ * GPIO 3, reset GPIO 66, irq GPIO 67 (falling edge), TLMM at 0x03000000
+ * (pin n registers at 0x1000 * n: CFG, then IN_OUT). Bit-banged I2C only; the
+ * QUP block is not touched (it hung on whyred). The thread scans the bus,
+ * resets the chip, reads the ID registers and then dumps the touch registers.
+ */
+extern int sweet_console_muted;
+/*
+ * TULIP 0271: kernel_thread_start()/thread_deallocate() come from
+ * <kern/thread.h>, which this file now includes for exactly that reason.
+ * The original patch re-declared them here, which is a conflicting
+ * declaration against the header and fails a -Werror build.
+ */
+static volatile uint32_t *tt_a, *tt_b;
+static int tt_lines;
+#define TT_HALF 5
+
+static volatile uint32_t *
+tt_cfg(int pin)
+{
+	return pin < 4 ? tt_a + (pin - 2) * 0x400 : tt_b + (pin - 66) * 0x400;
+}
+
+/* pull: 0 none, 1 down, 3 up. Output: OE set and value written first. */
+static void
+tt_set(int pin, int oe, int val, int pull)
+{
+	volatile uint32_t *r = tt_cfg(pin);
+
+	r[1] = val ? 2u : 0u;
+	r[0] = (uint32_t)(pull & 3) | (2u << 5) | (oe ? (1u << 9) : 0u);
+}
+
+static int
+tt_get(int pin)
+{
+	return (int)(tt_cfg(pin)[1] & 1u);
+}
+
+static void
+tt_sda(int h)
+{
+	tt_set(2, !h, 0, 3);
+}
+
+static void
+tt_scl(int h)
+{
+	int n = 0;
+
+	tt_set(3, !h, 0, 3);
+	if (h) {
+		while (!tt_get(3) && n++ < 2000) {
+			tulip_udelay(1);
+		}
+	}
+}
+
+static void
+tt_start(void)
+{
+	tt_sda(1); tt_scl(1); tulip_udelay(TT_HALF);
+	tt_sda(0); tulip_udelay(TT_HALF);
+	tt_scl(0); tulip_udelay(TT_HALF);
+}
+
+static void
+tt_stop(void)
+{
+	tt_sda(0); tulip_udelay(TT_HALF);
+	tt_scl(1); tulip_udelay(TT_HALF);
+	tt_sda(1); tulip_udelay(TT_HALF);
+}
+
+static int
+tt_wbyte(uint8_t b)
+{
+	int i, ack;
+
+	for (i = 0; i < 8; i++) {
+		tt_sda((b & 0x80) != 0);
+		tulip_udelay(TT_HALF);
+		tt_scl(1); tulip_udelay(TT_HALF);
+		tt_scl(0);
+		b = (uint8_t)(b << 1);
+	}
+	tt_sda(1); tulip_udelay(TT_HALF);
+	tt_scl(1); tulip_udelay(TT_HALF);
+	ack = !tt_get(2);
+	tt_scl(0); tulip_udelay(TT_HALF);
+	return ack;
+}
+
+static uint8_t
+tt_rbyte(int ack)
+{
+	uint8_t v = 0;
+	int i;
+
+	tt_sda(1);
+	for (i = 0; i < 8; i++) {
+		tulip_udelay(TT_HALF);
+		tt_scl(1); tulip_udelay(TT_HALF);
+		v = (uint8_t)((v << 1) | tt_get(2));
+		tt_scl(0);
+	}
+	tt_sda(!ack); tulip_udelay(TT_HALF);
+	tt_scl(1); tulip_udelay(TT_HALF);
+	tt_scl(0); tulip_udelay(TT_HALF);
+	tt_sda(1);
+	return v;
+}
+
+/* Register read with repeated start; returns 0 on ACK of both addresses. */
+static int
+tt_read(uint8_t addr, uint8_t reg, uint8_t *buf, int n)
+{
+	int i;
+
+	tt_start();
+	if (!tt_wbyte((uint8_t)(addr << 1)) || !tt_wbyte(reg)) {
+		tt_stop();
+		return -1;
+	}
+	tt_start();
+	if (!tt_wbyte((uint8_t)((addr << 1) | 1))) {
+		tt_stop();
+		return -2;
+	}
+	for (i = 0; i < n; i++) {
+		buf[i] = tt_rbyte(i < n - 1);
+	}
+	tt_stop();
+	return 0;
+}
+
+static void
+tt_dump(const char *tag, const uint8_t *b, int rc)
+{
+	if (tt_lines++ > 400) {
+		return;
+	}
+	printf("TULIP TOUCH: %s rc %d irq %d  %02x %02x %02x %02x %02x %02x %02x %02x"
+	    " %02x %02x %02x %02x %02x %02x %02x %02x"
+	    " %02x %02x %02x %02x %02x %02x %02x %02x\n", tag, rc, tt_get(67),
+	    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10],
+	    b[11], b[12], b[13], b[14], b[15], b[16], b[17], b[18], b[19], b[20],
+	    b[21], b[22], b[23]);
+}
+
+static void
+tulip_touch_thread(void *arg, wait_result_t w)
+{
+	static int chan;
+	uint8_t b[24], last2 = 0xff, id[2];
+	int muted, a, rc, found = 0, i, since = 0;
+
+	(void)arg; (void)w;
+	(void)tsleep(&chan, PZERO, "tulipts", 30 * hz);
+	muted = sweet_console_muted;
+	sweet_console_muted = 0;
+	tt_a = (volatile uint32_t *)ml_io_map(0x03002000, 0x2000);
+	tt_b = (volatile uint32_t *)ml_io_map(0x03042000, 0x2000);
+	printf("TULIP TOUCH: probe start, TLMM %p %p\n", (void *)tt_a, (void *)tt_b);
+
+	/* reset: irq pulled up as input, reset low 5 ms then high, 300 ms to boot */
+	tt_set(67, 0, 0, 3);
+	tt_set(66, 1, 1, 0);
+	tulip_udelay(2000);
+	tt_set(66, 1, 0, 0);
+	tulip_udelay(5000);
+	tt_set(66, 1, 1, 0);
+	tulip_udelay(300000);
+	tt_sda(1); tt_scl(1);
+	printf("TULIP TOUCH: idle SDA %d SCL %d irq %d\n", tt_get(2), tt_get(3), tt_get(67));
+
+	for (a = 0x08; a < 0x78; a++) {
+		tt_start();
+		rc = tt_wbyte((uint8_t)(a << 1));
+		tt_stop();
+		if (rc) {
+			printf("TULIP TOUCH: ACK at 0x%02x\n", a);
+			found++;
+		}
+	}
+	printf("TULIP TOUCH: scan done, %d device(s)\n", found);
+
+	if (tt_read(0x38, 0xa3, id, 1) == 0) {
+		printf("TULIP TOUCH: chip id reg A3 = 0x%02x\n", id[0]);
+	}
+	if (tt_read(0x38, 0xa8, id, 1) == 0) {
+		printf("TULIP TOUCH: vendor id reg A8 = 0x%02x\n", id[0]);
+	}
+	if (tt_read(0x38, 0xa6, id, 1) == 0) {
+		printf("TULIP TOUCH: firmware ver reg A6 = 0x%02x\n", id[0]);
+	}
+	rc = tt_read(0x38, 0x00, b, 24);
+	tt_dump("regs", b, rc);
+	sweet_console_muted = muted;
+
+	for (i = 0; i < 100000 && found; i++) {
+		(void)tsleep(&chan, PZERO, "tulipts", hz / 10 ? hz / 10 : 1);
+		memset(b, 0, sizeof(b));
+		rc = tt_read(0x38, 0x00, b, 24);
+		since++;
+		if (rc == 0 && ((b[2] & 0xf) != 0 || b[2] != last2 || since >= 100)) {
+			since = 0;
+			last2 = b[2];
+			muted = sweet_console_muted;
+			sweet_console_muted = 0;
+			tt_dump("data", b, rc);
+			sweet_console_muted = muted;
+		}
+	}
+}
+
+static void
+tulip_touch_start(void)
+{
+	thread_t th;
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("touchprobe", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (kernel_thread_start(tulip_touch_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+
 static void tulip_log_start(void);
 static void tulip_fb_test(void);
 
@@ -5148,6 +5381,8 @@
 	sweet_sample_start();
 	/* TULIP 0252: periodic sync of the journal-less root */
 	tulip_sync_start();
+	/* TULIP 0271: FTS touch probe (boot-arg touchprobe=1) */
+	tulip_touch_start();
 	return 0;
 }
 
