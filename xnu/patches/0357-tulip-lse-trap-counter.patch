+/*
+ * TULIP 0357: how often does userland trap into the kernel for an instruction
+ * the CPU cannot run?
+ *
+ * The iPhone X userland is built for ARMv8.2-A, which has the LSE atomics
+ * (CASA, CASAL, LDADD, SWP, LDAPR). Snapdragon 636 is ARMv8.0-A and has none
+ * of them, so every atomic in dyld, libsystem_platform, libsystem_pthread and
+ * QuartzCore has to be emulated by the kernel. A single emulated atomic costs
+ * roughly a thousand times what the instruction would, and a boot runs
+ * hundreds of millions of them.
+ *
+ * Count them and remember the last opcode, so HB19 can say whether this is the
+ * bottleneck worth attacking rather than one we assume is there.
+ */
+volatile uint64_t tulip_lse_traps;
+volatile uint32_t tulip_lse_last_instr;
+volatile uint32_t tulip_lse_hist[16];   /* top nibble of the opcode */
+volatile uint64_t tulip_undef_traps;    /* everything else */
+volatile uint32_t tulip_undef_last_instr;
+
 volatile uint32_t tulip_irq_lastother;
 
 void
