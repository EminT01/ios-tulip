diff -U3 -r a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c	2026-11-27 22:47:51.828342050 +0300
+++ b/osfmk/arm64/sleh.c	2026-11-27 22:47:51.833147400 +0300
@@ -889,6 +889,29 @@
 
 	COPYIN(get_saved_state_pc(state), (char *)&instr, sizeof(instr));
 
+	/*
+	 * TULIP 0357: count user traps and separate the LSE atomics from
+	 * everything else. A user instruction that reached this point cannot be
+	 * executed by this core, and on this SoC the overwhelming majority are
+	 * the ARMv8.2 atomics. Bin them by their opcode's top nibble so HB19 can
+	 * show a short histogram instead of one number.
+	 */
+	if (PSR64_IS_USER64(get_saved_state_cpsr(state))) {
+		bool is_lse = ((instr & 0x3f200c00u) == 0x38200000u) ||   /* CAS*  */
+		    ((instr & 0x3f200c00u) == 0x38200800u) ||             /* LDADD/SWP */
+		    ((instr & 0xfffffc00u) == 0xdac00000u) ||             /* LDAPR (8.3) */
+		    ((instr & 0xffe0fc00u) == 0x3820fc00u);               /* STADD etc. */
+
+		if (is_lse) {
+			tulip_lse_traps++;
+			tulip_lse_last_instr = instr;
+			tulip_lse_hist[(instr >> 28) & 0xf]++;
+		} else {
+			tulip_undef_traps++;
+			tulip_undef_last_instr = instr;
+		}
+	}
+
 #if CONFIG_DTRACE
 
