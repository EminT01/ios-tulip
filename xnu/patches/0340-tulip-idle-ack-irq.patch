diff -U3 -r a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
--- a/osfmk/arm64/cpu.c	2026-11-26 23:41:21.961908734 +0300
+++ b/osfmk/arm64/cpu.c	2026-11-26 23:41:21.962321949 +0300
@@ -612,6 +612,42 @@
 				tulip_idle_ast[cpu_data_ptr->cpu_number & 7]++;
 				break;
 			}
+			/*
+			 * TULIP 0340: a pending Group 1 interrupt has to be taken off
+			 * the CPU interface here.
+			 *
+			 * HB14 said every secondary woke 42 to 81 MILLION times in 44
+			 * seconds while its enter counter stayed at 1, and HB7 said four
+			 * cores never take a timer interrupt at all. Both come from the
+			 * same mistake: this loop never reads ICC_IAR1_EL1, so an
+			 * interrupt that arrives while the core is idle stays pending,
+			 * WFI returns immediately, and the core spins at a million wakes
+			 * a second doing no work. It also starves the one core that
+			 * actually runs the UI, which is the ten-second lag on a key
+			 * press.
+			 *
+			 * Read IAR1: anything below 1020 is a real interrupt. Acknowledge
+			 * it with EOI and leave the idle loop so the normal handler can
+			 * run - cpu_idle() returns, the scheduler runs, and the interrupt
+			 * is serviced through sleh_irq(). A spurious id (1020-1023) is
+			 * dropped and the core sleeps again.
+			 */
+			{
+				extern volatile uint64_t tulip_idle_irq[8];
+				uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+				uint32_t id = (uint32_t)(iar & 0xFFFFFF);
+
+				if (id < 1020) {
+					__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+					__builtin_arm_isb(ISB_SY);
+					tulip_idle_irq[cpu_data_ptr->cpu_number & 7]++;
+					break;
+				}
+				if (id > 1023) {
+					/* not a spurious id either: leave it alone */
+					break;
+				}
+			}
 			wfi_deadline = tulip_soft_tick_arm();
 			if (wfi_deadline == 0) {
 				tulip_idle_arm0[cpu_data_ptr->cpu_number & 7]++;
@@ -628,6 +664,23 @@
 			__asm__ volatile ("mrs %0, cntpct_el0" : "=r"(tulip_idle_t1));
 			tulip_idle_ticks[cpu_data_ptr->cpu_number & 7] += tulip_idle_t1 - tulip_idle_t0;
 			tulip_idle_wakes[cpu_data_ptr->cpu_number & 7]++;
+			/*
+			 * And once more after WFI: that is where the interrupt that woke
+			 * the core is waiting on this SoC, because TrustZone delivers the
+			 * timer as a Group 1 IRQ rather than an FIQ.
+			 */
+			{
+				extern volatile uint64_t tulip_idle_irq[8];
+				uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+				uint32_t id = (uint32_t)(iar & 0xFFFFFF);
+
+				if (id < 1020) {
+					__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+					__builtin_arm_isb(ISB_SY);
+					tulip_idle_irq[cpu_data_ptr->cpu_number & 7]++;
+					break;
+				}
+			}
 		}
 		Idle_load_context();
 	}
