diff -U3 -r n362_a/bsd/dev/tulip_sdhci.c n362_b/bsd/dev/tulip_sdhci.c
--- a/bsd/dev/tulip_sdhci.c	2026-11-28 03:23:42.116144772 +0300
+++ b/bsd/dev/tulip_sdhci.c	2026-11-28 03:24:12.522129714 +0300
@@ -5839,9 +5839,20 @@
 									ready++;
 								}
 							}
-							if (ready == 8) {
+							/*
+							 * TULIP 0362: six of the eight stages is enough.
+							 *
+							 * HB5 reads "stage 1f 7f 7f 7f 7f 7f 7f 7f": the
+							 * boot CPU stays at 0x1f because it never goes
+							 * through processor_start(), so 0x40 is only ever
+							 * set on the seven secondaries. Waiting for
+							 * ready == 8 meant the boost never ran, which is
+							 * why no boot has printed "all 8 cores running".
+							 */
+							if (ready >= 6) {
 								gold_done = 1;
-								printf("TULIP CLK: all 8 cores running, boosting gold\n");
+								printf("TULIP CLK: %u/8 cores running, boosting gold\n",
+								    ready);
 								tulip_boost_gold_pll();
 							}
 						}
diff -U3 -r n362_a/bsd/vfs/vfs_subr.c n362_b/bsd/vfs/vfs_subr.c
--- a/bsd/vfs/vfs_subr.c	2026-11-23 03:13:57.000000000 +0300
+++ b/bsd/vfs/vfs_subr.c	2026-11-28 03:24:12.520043398 +0300
@@ -1267,6 +1267,16 @@
 			if (PE_parse_boot_argn("rootrw", &rootrw, sizeof(rootrw)) && rootrw) {
 				mp->mnt_flag &= ~MNT_RDONLY;
 			}
+			/*
+			 * TULIP 0362: do not write access times on the root.
+			 *
+			 * Boot reads dyld_shared_cache and a few hundred system
+			 * libraries, and every read that dirties a vnode pulls a
+			 * journaled atime write behind it. hfs_vfsops.c already
+			 * honours MNT_NOATIME, it was simply never set on the root
+			 * mount.
+			 */
+			mp->mnt_flag |= MNT_NOATIME;
 		}
 #endif
 
