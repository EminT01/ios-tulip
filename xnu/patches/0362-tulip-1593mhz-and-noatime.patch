+static void
+tulip_boost_cluster_pll(const char *tag, vm_offset_t base, uint32_t target_l, uint32_t target_src)
+{
+	uint32_t orig_cfg, orig_l, new_l, user_ctl, safe_cfg, target_cfg, timeout;
+
+	orig_cfg = tulip_clk_rd32(base, APCS_CFG_RCGR);
+	user_ctl = tulip_clk_rd32(base, APCS_PLL_USER_CTL);
+	IOLog("TULIP CLK: %s S1 cfg %#x L %#x user %#x mode %#x\n",
+	    tag, orig_cfg, tulip_clk_rd32(base, APCS_PLL_L_VAL), user_ctl,
+	    tulip_clk_rd32(base, APCS_PLL_MODE));
+
+	/* 1. Park RCG on GPLL0 (SRC_SEL 0, HID_DIV 1) while cores execute. */
+	safe_cfg = (orig_cfg & ~RCG_SRC_SEL_MASK) | (HID_DIV_ONE & RCG_DIV_MASK);
+	if (tulip_rcg_switch(base, safe_cfg) != 0) {
+		IOLog("TULIP CLK: %s park to GPLL0 timed out, left alone\n", tag);
+		return;
+	}
+
+	/* 2. Stop PLL, preserve upper 16-bit CAL_L_VAL, set new L, and relock. */
+	orig_l = tulip_clk_rd32(base, APCS_PLL_L_VAL);
+	new_l = (orig_l & ~0xffffu) | target_l;
+	tulip_clk_wr32(base, APCS_PLL_USER_CTL, user_ctl & ~APCS_PLL_OUTCTRL);
+	tulip_clk_wr32(base, APCS_PLL_MODE, 0x0u);
+	tulip_clk_udelay(5);
+	tulip_clk_wr32(base, APCS_PLL_L_VAL, new_l);
+	tulip_clk_wr32(base, APCS_PLL_ALPHA_VAL, 0x0u);
+	tulip_clk_wr32(base, APCS_PLL_MODE, APCS_PLL_BYPASSNL);
+	tulip_clk_udelay(5);
+	tulip_clk_wr32(base, APCS_PLL_MODE, APCS_PLL_BYPASSNL | APCS_PLL_RESET_N);
+
+	timeout = 500;
+	while (!(tulip_clk_rd32(base, APCS_PLL_MODE) & APCS_PLL_LOCK_DET)) {
+		if (--timeout == 0) {
+			IOLog("TULIP CLK: %s S2 lock timeout (mode %#x), stays on GPLL0\n",
+			    tag, tulip_clk_rd32(base, APCS_PLL_MODE));
+			return;
+		}
+		tulip_clk_udelay(1);
+	}
+
+	/* 3. Enable PLL output and switch RCG back to cluster PLL. */
+	tulip_clk_wr32(base, APCS_PLL_USER_CTL, user_ctl);
+	tulip_clk_wr32(base, APCS_PLL_MODE,
+	    APCS_PLL_BYPASSNL | APCS_PLL_RESET_N | APCS_PLL_OUTCTRL);
+
+	target_cfg = (orig_cfg & ~(RCG_SRC_SEL_MASK | RCG_DIV_MASK)) | target_src;
+	if (tulip_rcg_switch(base, target_cfg) != 0) {
+		IOLog("TULIP CLK: %s S3 restore timeout\n", tag);
+		return;
+	}
+
+	IOLog("TULIP CLK: %s OK L %#x (%u MHz) cfg %#x\n",
+	    tag, tulip_clk_rd32(base, APCS_PLL_L_VAL),
+	    (unsigned)(((tulip_clk_rd32(base, APCS_PLL_L_VAL) & 0xffu) * 192u) / 10u),
+	    tulip_clk_rd32(base, APCS_CFG_RCGR));
+}
