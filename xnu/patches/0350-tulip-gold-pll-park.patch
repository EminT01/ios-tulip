+/*
+ * TULIP 0350: Gold cluster to 1401.6 MHz, done safely.
+ *
+ * HB9 says "gold mode 7 L 20 user f": the ABL already locked the Gold PLL
+ * (0x17816000) with working CONFIG_CTL / USER_CTL, it only left the multiplier
+ * at L = 0x20 (614.4 MHz). HB6 then reads "1382 1382 1382 1382 600 600 600
+ * 600", so all four Gold cores run at the low step while the Silver ones sit
+ * near the top - which is half of why cpus=8 feels like cpus=1.
+ *
+ * The trap, and the reason 0345 would have frozen the phone: by the time this
+ * runs, cpu4..cpu7 are already awake on that PLL. Turning it off while they
+ * fetch from it stops them dead. So park the Gold RCG on GPLL0 (SRC_SEL = 0)
+ * FIRST, reprogram the PLL, then point the RCG back at it. A lock timeout
+ * leaves the cluster running safely on GPLL0 at 600 MHz.
+ *
+ * No voltage change: both clusters use L = 0x49 (73 x 19.2 MHz) at the same
+ * APM mode, and the Gold rail is already Nominal, which covers that band.
+ */
+#define PWRCL_BASE_PA        0x17910000u
+#define PERFCL_BASE_PA       0x17810000u
+#define APCS_APM_PA          0x179d0000u
+
+#define APCS_CMD_RCGR        0x1050u
+#define APCS_CFG_RCGR        0x1054u
+
+#define APCS_PLL_MODE        0x6000u
+#define APCS_PLL_L_VAL       0x6004u
+#define APCS_PLL_ALPHA_VAL   0x6008u
+#define APCS_PLL_USER_CTL    0x600cu
+
+#define APCS_PLL_OUTCTRL     (1u << 0)
+#define APCS_PLL_BYPASSNL    (1u << 1)
+#define APCS_PLL_RESET_N     (1u << 2)
+#define APCS_PLL_LOCK_DET    (1u << 31)
+
+#define RCG_UPDATE           (1u << 0)
+#define RCG_DIV_MASK         0x1fu
+#define RCG_SRC_SEL_SHIFT    8u
+#define RCG_SRC_SEL_MASK     (0x7u << RCG_SRC_SEL_SHIFT)
+
+#define PWRCL_APM_CTL        0x0004u
+#define PERFCL_APM_CTL       0x0010u
+
+#define GOLD_TARGET_L        0x49u             /* 73 x 19.2 MHz = 1401.6 */
+
+static inline uint32_t
+tulip_clk_rd32(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+tulip_clk_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static void
+tulip_clk_udelay(uint32_t us)
+{
+	uint64_t start, now, ticks = ((uint64_t)us * 192ull) / 10ull;
+
+	__asm__ volatile ("isb; mrs %0, cntpct_el0" : "=r"(start));
+	do {
+		__asm__ volatile ("isb; mrs %0, cntpct_el0" : "=r"(now));
+	} while ((now - start) < ticks);
+}
+
+static int
+tulip_rcg_switch(vm_offset_t base, uint32_t cfg)
+{
+	uint32_t timeout = 500;
+
+	tulip_clk_wr32(base, APCS_CFG_RCGR, cfg);
+	tulip_clk_wr32(base, APCS_CMD_RCGR,
+	    tulip_clk_rd32(base, APCS_CMD_RCGR) | RCG_UPDATE);
+	while (tulip_clk_rd32(base, APCS_CMD_RCGR) & RCG_UPDATE) {
+		if (--timeout == 0) {
+			return -1;
+		}
+		tulip_clk_udelay(1);
+	}
+	return 0;
+}
+
+void
+tulip_boost_gold_pll(void)
+{
+	static int done;
+	vm_offset_t pwr, perf, apm;
+	uint32_t orig_perf_cfg, silver_src, user_ctl, safe_cfg, target_cfg, timeout;
+
+	if (done) {
+		return;
+	}
+	done = 1;
+
+	pwr = ml_io_map(PWRCL_BASE_PA, 0x8000);
+	perf = ml_io_map(PERFCL_BASE_PA, 0x8000);
+	apm = ml_io_map(APCS_APM_PA, 0x1000);
+	if (pwr == 0 || perf == 0 || apm == 0) {
+		IOLog("TULIP CLK: gold boost: ml_io_map failed\n");
+		return;
+	}
+
+	orig_perf_cfg = tulip_clk_rd32(perf, APCS_CFG_RCGR);
+	silver_src = tulip_clk_rd32(pwr, APCS_CFG_RCGR) & RCG_SRC_SEL_MASK;
+	user_ctl = tulip_clk_rd32(perf, APCS_PLL_USER_CTL);
+	IOLog("TULIP CLK: gold boost: pll mode %#x L %#x user %#x cfg %#x\n",
+	    tulip_clk_rd32(perf, APCS_PLL_MODE), tulip_clk_rd32(perf, APCS_PLL_L_VAL),
+	    user_ctl, orig_perf_cfg);
+
+	/*
+	 * 1. Park the Gold RCG on GPLL0 (SRC_SEL 0) while cpu4..cpu7 are still
+	 *    running, so the PLL can be stopped without stopping them.
+	 */
+	safe_cfg = orig_perf_cfg & ~(RCG_SRC_SEL_MASK | RCG_DIV_MASK);
+	if (tulip_rcg_switch(perf, safe_cfg) != 0) {
+		IOLog("TULIP CLK: gold boost: park to GPLL0 timed out, left alone\n");
+		return;
+	}
+
+	/* 2. Stop the PLL and relock it at L = 0x49. */
+	tulip_clk_wr32(perf, APCS_PLL_USER_CTL, user_ctl & ~APCS_PLL_OUTCTRL);
+	tulip_clk_wr32(perf, APCS_PLL_MODE, 0x0u);
+	tulip_clk_udelay(5);
+	tulip_clk_wr32(perf, APCS_PLL_L_VAL, GOLD_TARGET_L);
+	tulip_clk_wr32(perf, APCS_PLL_ALPHA_VAL, 0x0u);
+	tulip_clk_wr32(perf, APCS_PLL_MODE, APCS_PLL_BYPASSNL);
+	tulip_clk_udelay(5);
+	tulip_clk_wr32(perf, APCS_PLL_MODE, APCS_PLL_BYPASSNL | APCS_PLL_RESET_N);
+
+	timeout = 500;
+	while (!(tulip_clk_rd32(perf, APCS_PLL_MODE) & APCS_PLL_LOCK_DET)) {
+		if (--timeout == 0) {
+			/* Leave the cluster on GPLL0 at 600 MHz: safe, just not fast. */
+			IOLog("TULIP CLK: gold boost: PLL lock timed out, cluster stays "
+			    "on GPLL0 (600 MHz)\n");
+			return;
+		}
+		tulip_clk_udelay(1);
+	}
+
+	/* 3. Turn the PLL back on and match the Silver APM mode. */
+	tulip_clk_wr32(perf, APCS_PLL_USER_CTL, user_ctl);
+	tulip_clk_wr32(perf, APCS_PLL_MODE,
+	    APCS_PLL_BYPASSNL | APCS_PLL_RESET_N | APCS_PLL_OUTCTRL);
+	tulip_clk_wr32(apm, PERFCL_APM_CTL, tulip_clk_rd32(apm, PWRCL_APM_CTL));
+
+	/* 4. Point the Gold RCG back at the cluster PLL, same source as Silver. */
+	target_cfg = (orig_perf_cfg & ~(RCG_SRC_SEL_MASK | RCG_DIV_MASK)) | silver_src;
+	if (tulip_rcg_switch(perf, target_cfg) != 0) {
+		IOLog("TULIP CLK: gold boost: switch back to the PLL timed out\n");
+		return;
+	}
+
+	IOLog("TULIP CLK: gold boosted L=%#x (%u MHz) cfg %#x\n",
+	    tulip_clk_rd32(perf, APCS_PLL_L_VAL),
+	    (unsigned)(19.2 * (tulip_clk_rd32(perf, APCS_PLL_L_VAL) & 0xffu)),
+	    tulip_clk_rd32(perf, APCS_CFG_RCGR));
+}
