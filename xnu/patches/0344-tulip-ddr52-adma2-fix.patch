  * plausible. Repair with the one command that fits and re-check; each branch
  * is logged, so the boot log says which state the hand-off was in.
  */
+
+/*
+ * TULIP 0344: 8-bit DDR52.
+ *
+ * PIO tops out at about 6.5 MB/s on this board no matter what the bus does,
+ * because every 512-byte block costs a FIFO poll and 128 MMIO word reads. In
+ * single data rate the card only moves data on the rising edge, so even a
+ * perfect DMA path would stay at 50 MB/s. DDR52 samples both edges at the same
+ * 50 MHz, which doubles the ceiling to 100 MB/s - and it needs no tuning, no
+ * DLL and no HS200/HS400 machinery.
+ *
+ * Sequence (JESD84 / SDHCI 3.0):
+ *   1. CMD6 switch EXT_CSD[BUS_WIDTH] = 6 (8-bit DDR)   arg 0x03B70600
+ *   2. wait DAT0 high, then CMD13 until the card is in TRAN with no
+ *      SWITCH_ERROR
+ *   3. HOST_CONTROL2 UHS mode select = 0x4 (DDR50), 64-bit addressing stays 0
+ *   4. CMD8 SEND_EXT_CSD to prove the data path still moves a block
+ *
+ * Any failure leaves the single-rate 8-bit path alone: this only ever adds
+ * speed, never takes the boot with it.
+ */
+static int
+sdhci_enable_ddr52(void)
+{
+	uint32_t r1 = 0, ps = 0;
+	int error, i;
+
+	/* 1. BUS_WIDTH = 0x06, 8-bit DDR */
+	error = sdhci_cmd(6, (EXT_CSD_ACCESS << 24) | (EXT_CSD_BUS_WIDTH << 16) |
+	    (EXT_CSD_BW_8_DDR << 8), 0,
+	    SDHCI_CMD_RESP_SHORT_BUSY | SDHCI_CMD_CRC | SDHCI_CMD_INDEX, &r1);
+	if (error) {
+		printf("TULIP SDHCI: DDR52: CMD6 BUS_WIDTH=6 failed (%d)\n", error);
+		return error;
+	}
+	if (r1 & 0x80u) {                       /* bit 7 = SWITCH_ERROR */
+		printf("TULIP SDHCI: DDR52: card rejected BUS_WIDTH=6 (R1 0x%08x)\n", r1);
+		return EIO;
+	}
+
+	/* 2. DAT0 high, then TRAN */
+	for (i = 0; i < 1000; i++) {
+		ps = hc_rd(SDHCI_PRESENT_STATE);
+		if (ps & SDHCI_PS_DAT0) {
+			break;
+		}
+		delay(1);
+	}
+	if (!(ps & SDHCI_PS_DAT0)) {
+		printf("TULIP SDHCI: DDR52: DAT0 never went high (PRESENT_STATE 0x%08x)\n", ps);
+		return ETIMEDOUT;
+	}
+	error = sdhci_cmd(13, 0, 0, SDHCI_CMD_RESP_SHORT, &r1);
+	if (error) {
+		printf("TULIP SDHCI: DDR52: CMD13 failed (%d)\n", error);
+		return error;
+	}
+	if ((r1 & 0x80u) || ((r1 >> 9) & 0xfu) != 4u) {
+		printf("TULIP SDHCI: DDR52: card not in TRAN/SWITCH_ERROR (R1 0x%08x)\n", r1);
+		return EIO;
+	}
+
+	/* 3. HOST_CONTROL2: UHS mode = DDR50, 64-bit addressing stays off */
+	{
+		uint16_t hc2 = hc_rd16(SDHCI_HOST_CONTROL2);
+
+		hc2 &= (uint16_t)~0x7u;             /* clear UHS mode select */
+		hc2 |= SDHCI_CTRL2_DDR50;
+		hc2 &= (uint16_t)~(1u << 5);        /* 32-bit descriptor, not 64 */
+		hc_wr16(SDHCI_HOST_CONTROL2, hc2);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("TULIP SDHCI: DDR52: HOST_CONTROL2 0x%04x (UHS mode DDR50)\n",
+		    hc_rd16(SDHCI_HOST_CONTROL2));
+	}
+
+	/* 4. prove a block still moves */
+	error = sdhci_read_pio_once(8, 0, 1, (void *)(se.dma + DMA_BOUNCE));
+	if (error) {
+		printf("TULIP SDHCI: DDR52: CMD8 after the switch failed (%d), "
+		    "back to 8-bit single rate\n", error);
+		return error;
+	}
+	printf("TULIP SDHCI: DDR52 active: 8-bit, dual edge, 50 MHz, "
+	    "EXT_CSD read back clean\n");
+	return 0;
+}
