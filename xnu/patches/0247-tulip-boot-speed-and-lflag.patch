--- a/bsd/dev/tulip_sdhci.c
+++ b/bsd/dev/tulip_sdhci.c
@@ -1146,3 +1146,12 @@
 {
+	/*
+	 * TULIP 0247: 0243 polls CMD13 up to 500 ms per call and is also on the
+	 * success path and the read retry path. Reaching backboardd took 35
+	 * minutes; skip the poll unless explicitly debugging the card.
+	 */
+	static const bool tulip_0247_slow_wait = false;
+	if (!tulip_0247_slow_wait) {
+		return;
+	}
 	uint64_t deadline;
 	uint32_t r1 = 0;
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2310,3 +2310,10 @@
 	}
 
+	/*
+	 * TULIP 0247: proc_prepareexit() is skipped (0233) and nothing else
+	 * clears these, so every child stays P_LTERM and takes the slow retry
+	 * path in proc_transend() and wait4().
+	 */
+	p->p_lflag &= ~(P_LTERM | P_LWAITED | P_LPEXIT);
+
 	proc_refdrain(p);
