diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index c61a929..2478d88 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -562,6 +562,11 @@ machine_lockdown(void)
 #if !defined(VINCE) || !defined(TULIP_SMP)
 	ml_set_max_cpus(machine_info.max_cpus);
 #endif
+#if defined(VINCE) && defined(TULIP_SMP)
+	/* SweetCPU::finishStart() runs from an IOKit start() that has not happened yet,
+	 * so nothing would wake ml_wait_max_cpus() here.  Publish it now (idempotent). */
+	ml_set_max_cpus(machine_info.max_cpus);
+#endif
 }
 
 
